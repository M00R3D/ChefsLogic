  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:usuarios": "node src/seeders/userSeeder.js",
    "seed:regions": "node src/seeders/regionSeeder.js",
    "seed:regiones": "node src/seeders/regionSeeder.js",
    "seed:recetas": "node src/seeders/recipeSeeder.js",
