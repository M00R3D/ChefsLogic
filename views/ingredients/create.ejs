<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="app-shell">
      <%- include("../partials/navbar", { activeTab }) %>

      <main class="main-content">
        <%- include("../partials/header", { pageTitle: "Nuevo ingrediente" }) %>

        <section class="card">
          <% if (errorMessage) { %>
            <p class="muted"><%= errorMessage %></p>
          <% } %>

          <form class="form-grid" action="/ingredients" method="POST">
            <div class="form-grid cols-2">
              <label>
                Nombre
                <input name="name" type="text" required />
              </label>

              <label>
                Categoria
                <select name="category">
                  <option value="verdura">Verdura</option>
                  <option value="fruta">Fruta</option>
                  <option value="proteina">Proteina</option>
                  <option value="grano">Grano</option>
                  <option value="especia">Especia</option>
                  <option value="lacteo">Lacteo</option>
                  <option value="otro" selected>Otro</option>
                </select>
              </label>
            </div>

            <div class="form-grid cols-2">
              <label>
                Unidad por defecto
                <select name="defaultUnit">
                  <option value="g">g</option>
                  <option value="kg">kg</option>
                  <option value="ml">ml</option>
                  <option value="l">l</option>
                  <option value="pieza">pieza</option>
                  <option value="cdita">cdita</option>
                  <option value="cda">cda</option>
                  <option value="taza">taza</option>
                </select>
              </label>

              <label>
                Estacionalidad (meses separados por coma)
                <input name="seasonality" type="text" placeholder="enero, febrero" />
              </label>
            </div>

            <div class="form-grid cols-2">
              <label>
                Calorias
                <input name="calories" type="number" min="0" step="0.01" />
              </label>
              <label>
                Proteina
                <input name="protein" type="number" min="0" step="0.01" />
              </label>
            </div>

            <div class="form-grid cols-2">
              <label>
                Carbohidratos
                <input name="carbs" type="number" min="0" step="0.01" />
              </label>
              <label>
                Grasas
                <input name="fat" type="number" min="0" step="0.01" />
              </label>
            </div>

            <label>
              Etiquetas (separadas por coma)
              <input name="tags" type="text" placeholder="fresco, local" />
            </label>

            <div class="actions">
              <button class="btn btn-primary" type="submit">Guardar ingrediente</button>
              <a class="btn btn-soft" href="/ingredients">Cancelar</a>
            </div>
          </form>
        </section>

        <%- include("../partials/footer") %>
      </main>
    </div>
  </body>
</html>
