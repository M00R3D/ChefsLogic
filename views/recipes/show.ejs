<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="app-shell">
      <%- include("../partials/navbar", { activeTab }) %>

      <main class="main-content">
        <%- include("../partials/header", { pageTitle: recipe ? recipe.title : "Detalle de receta" }) %>

        <% if (errorMessage) { %>
          <section class="card">
            <p class="muted"><%= errorMessage %></p>
            <a class="btn btn-soft" href="/recipes">Volver</a>
          </section>
        <% } %>

        <% if (recipe) { %>
          <section class="grid cols-2">
            <article class="card">
              <h3>Resumen</h3>
              <p class="muted"><%= recipe.summary || "Sin resumen." %></p>
              <div class="actions">
                <span class="chip"><%= recipe.difficulty %></span>
                <span class="chip"><%= recipe.status %></span>
                <span class="chip"><%= recipe.servings %> porciones</span>
              </div>
            </article>

            <article class="card">
              <h3>Tiempo</h3>
              <p class="muted">Preparacion: <%= recipe.prepMinutes %> min</p>
              <p class="muted">Coccion: <%= recipe.cookMinutes %> min</p>
              <p class="muted">Region: <%= recipe.region ? recipe.region.name : "Sin region" %></p>
            </article>
          </section>

          <section class="grid cols-2">
            <article class="card">
              <h3>Ingredientes</h3>
              <ul class="list">
                <% if (!recipe.ingredients || recipe.ingredients.length === 0) { %>
                  <li class="muted">No hay ingredientes cargados.</li>
                <% } %>
                <% recipe.ingredients.forEach((item) => { %>
                  <li>
                    <strong><%= item.ingredientName || (item.ingredient ? item.ingredient.name : "Ingrediente") %></strong>
                    <span class="muted"> - <%= item.quantity %> <%= item.unit %></span>
                  </li>
                <% }); %>
              </ul>
            </article>

            <article class="card">
              <h3>Pasos</h3>
              <ol class="list">
                <% if (!recipe.steps || recipe.steps.length === 0) { %>
                  <li class="muted">No hay pasos registrados.</li>
                <% } %>
                <% recipe.steps.forEach((step) => { %>
                  <li>
                    <strong>Paso <%= step.order %>:</strong>
                    <span class="muted"> <%= step.text %></span>
                  </li>
                <% }); %>
              </ol>
            </article>
          </section>

          <section class="card">
            <div class="actions">
              <a class="btn btn-soft" href="/recipes">Volver</a>
              <a class="btn btn-primary" href="/recipes/<%= recipe._id %>/edit">Editar receta</a>
            </div>
          </section>
        <% } %>

        <%- include("../partials/footer") %>
      </main>
    </div>
  </body>
</html>
