<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="app-shell">
      <%- include("../partials/navbar", { activeTab }) %>

      <main class="main-content">
        <%- include("../partials/header", { pageTitle: recipe ? recipe.title : "Detalle de receta" }) %>

        <% if (errorMessage) { %>
          <section class="card">
            <p class="muted"><%= errorMessage %></p>
            <a class="btn btn-soft" href="/recipes">Volver</a>
          </section>
        <% } %>

        <% if (recipe) { %>
          <% const imageCandidate = String(recipe.imageUrl || recipe.imagen_principal || '').trim(); %>
          <% const canRenderImage = /^(https?:\/\/|\/|data:image\/)/i.test(imageCandidate); %>
          <%
            const safeHex = /^#[0-9a-fA-F]{3,6}$/.test(String(recipe.accentColor||'')) ? recipe.accentColor : '';
            const diffColorMap = { facil: '#27ae60', media: '#e67e22', dificil: '#c0392b' };
            const heroAccent = safeHex || diffColorMap[String(recipe.difficulty||'media')] || '#546e7a';
            const heroEmoji = String(recipe.fallbackEmoji || '').trim() || (function(){
              const t = String((recipe.tags||[])[0]||'').toLowerCase();
              const em = { mexicana:'🌮', picante:'🌶️', vegano:'🌱', mariscos:'🦐', dulce:'🍯', sopa:'🍲', caldo:'🫕', tamal:'🫔', mole:'🏺', chili:'🌶️' };
              return em[t] || '🍳';
            })();
          %>
          <% const ingredientMeta = {
            verdura: { emoji: '🥦', color: '#2e7d32', bg: '#e8f5e9' },
            fruta: { emoji: '🍎', color: '#c62828', bg: '#ffebee' },
            proteina: { emoji: '🥩', color: '#b71c1c', bg: '#fff3e0' },
            grano: { emoji: '🌾', color: '#6d4c41', bg: '#efebe9' },
            especia: { emoji: '🌶️', color: '#e65100', bg: '#fff8e1' },
            lacteo: { emoji: '🧀', color: '#1565c0', bg: '#e3f2fd' },
            otro: { emoji: '🧺', color: '#546e7a', bg: '#f5f5f5' }
          }; %>
          <% const tagEmoji = {
            fresco: '🍃', dulce: '🍯', picante: '🌶️', ahumado: '🔥',
            tradicional: '🏺', casero: '🏠', crujiente: '🥨', cremoso: '🥛',
            saludable: '🥗', rapido: '⚡', vegano: '🌱', vegetariano: '🥬'
          }; %>
          <% const classifyStep = (text) => {
            const t = String(text || '').toLowerCase();
            if (/calentar|hervir|fre[ii]r|freir|tostar|hornear|dorar|asar|saltear|reducir|gratinar|flamear|sofreir|sellar|desglasar/.test(t)) return { icon: '🔥', type: 'heat' };
            if (/enfriar|refrigerar|reposar|congelar|templar/.test(t)) return { icon: '❄️', type: 'cool' };
            if (/picar|cortar|rebanar|pelar|lavar|limpiar|trozar|desvenar|deshuesar|juliana|cubos|rodaj|moler|triturar|procesar/.test(t)) return { icon: '🔪', type: 'cut' };
            if (/sazonar|condimentar|sal y pimienta|agregar sal|comino|oregano|pimienta|rectificar|ajustar/.test(t)) return { icon: '🧂', type: 'season' };
            if (/licuar|colar|batir|mezcl|integrar|incorporar|revolver|homogene|ligar/.test(t)) return { icon: '🌀', type: 'blend' };
            if (/marinar|remojar|macerar|hidratar/.test(t)) return { icon: '💧', type: 'soak' };
            if (/servir|decorar|emplatar|presentar|acompa|verter|espolvorear|terminar/.test(t)) return { icon: '🍽️', type: 'serve' };
            return { icon: '👨‍🍳', type: 'def' };
          }; %>

          <% if (imageCandidate && canRenderImage) { %>
            <img class="recipe-hero reveal" src="<%= imageCandidate %>" alt="<%= recipe.title %>" />
          <% } else { %>
            <div class="recipe-hero-accent reveal" style="--hero-bg:<%= heroAccent %>">
              <span class="recipe-hero-emoji"><%= heroEmoji %></span>
              <span class="recipe-hero-title"><%= recipe.title %></span>
            </div>
          <% } %>

          <section class="card reveal" style="margin-bottom:1.25rem;">
            <h1 class="recipe-title"><%= recipe.title %></h1>
            <p class="muted" style="margin-top:0;"><%= recipe.summary || "Sin resumen." %></p>

            <div class="recipe-meta-row">
              <span class="chip"><%= recipe.region ? recipe.region.name : "Sin region" %></span>
              <span class="chip"><%= recipe.difficulty || "media" %></span>
              <span class="chip"><%= recipe.servings || 1 %> porciones</span>
              <span class="chip"><%= (recipe.prepMinutes || 0) + (recipe.cookMinutes || 0) %> min total</span>
              <span class="status-badge <%= recipe.status || 'borrador' %>"><%= recipe.status || 'borrador' %></span>
            </div>

            <% if (Array.isArray(recipe.tags) && recipe.tags.length) { %>
              <div class="recipe-tag-cloud">
                <% recipe.tags.forEach((tag) => { %>
                  <% const t = String(tag || '').toLowerCase(); %>
                  <span class="recipe-tag-chip"><%= tagEmoji[t] || '🏷️' %> <%= tag %></span>
                <% }); %>
              </div>
            <% } %>

            <div class="interaction-bar">
              <button class="interaction-btn <%= userHasLiked ? 'active' : '' %>" type="button" data-recipe-like="<%= recipe._id %>">
                ❤ <span data-like-label><%= userHasLiked ? 'Te gusta' : 'Me gusta' %></span>
                <strong data-like-count><%= recipe.likeCount || 0 %></strong>
              </button>

              <button class="interaction-btn" type="button" data-recipe-dislike="<%= recipe._id %>">
                👎 Quitar like
              </button>

              <button class="interaction-btn <%= userHasSaved ? 'active' : '' %>" type="button" data-recipe-save="<%= recipe._id %>">
                🔖 <span data-save-label><%= userHasSaved ? 'Guardada' : 'Guardar' %></span>
              </button>

              <% if (!(typeof currentUser !== 'undefined' && currentUser)) { %>
                <a class="btn btn-ghost btn-sm" href="/login">Inicia sesion para interactuar</a>
              <% } %>
            </div>

            <div class="actions">
              <a class="btn btn-soft" href="/recipes">Volver</a>
              <% if (canEdit) { %>
                <a class="btn btn-primary" href="/recipes/<%= recipe._id %>/edit">Editar receta</a>
              <% } %>
            </div>
          </section>

          <section class="grid cols-2 reveal">
            <article class="card">
              <h3>Ingredientes</h3>
              <ul class="ingredients-list">
                <% if (!recipe.ingredients || recipe.ingredients.length === 0) { %>
                  <li class="muted">No hay ingredientes cargados.</li>
                <% } %>
                <% recipe.ingredients.forEach((item) => { %>
                  <% const cat = String((item.ingredient && (item.ingredient.category || item.ingredient.categoria)) || 'otro').toLowerCase(); %>
                  <% const meta = ingredientMeta[cat] || ingredientMeta.otro; %>
                  <li class="ingredient-item">
                    <span class="ingredient-dot cat-<%= cat %>"><%= meta.emoji %></span>
                    <div>
                      <strong><%= item.ingredientName || (item.ingredient ? item.ingredient.name : "Ingrediente") %></strong>
                      <div class="muted"><%= item.quantity %> <%= item.unit %></div>
                    </div>
                  </li>
                <% }); %>
              </ul>
            </article>

            <article class="card">
              <h3>Preparacion</h3>
              <div class="step-nodes-vertical">
                <% (recipe.steps || []).forEach((step, index) => { %>
                  <% const c = classifyStep(step.text); %>
                  <div class="step-node-v step-type-<%= c.type %>">
                    <div class="step-node-v-head">
                      <span class="step-node-v-icon"><%= c.icon %></span>
                      <span class="step-node-v-num"><%= index + 1 %></span>
                      <span class="step-node-v-label"><%= step.text %></span>
                    </div>
                  </div>
                  <% if (index < (recipe.steps || []).length - 1) { %>
                    <div class="step-node-v-arrow">↓</div>
                  <% } %>
                <% }); %>
                <% if (!recipe.steps || !recipe.steps.length) { %>
                  <p class="muted">No hay pasos registrados.</p>
                <% } %>
              </div>
            </article>
          </section>

          <section class="card reveal" style="margin-top:1.25rem;">
            <div class="section-heading" style="margin-bottom:0.8rem;">
              <h2 style="font-size:1.2rem;">Comentarios</h2>
            </div>

            <% if (typeof currentUser !== 'undefined' && currentUser) { %>
              <form id="comment-form" class="form-grid" data-comment-form="<%= recipe._id %>">
                <label>
                  Comparte tu tip o experiencia
                  <textarea name="commentText" placeholder="Ej: Lo hice con chile morita y quedo espectacular." required></textarea>
                </label>
                <div class="actions">
                  <button class="btn btn-primary" type="submit">Publicar comentario</button>
                </div>
              </form>
            <% } else { %>
              <p class="muted">Inicia sesion para comentar.</p>
            <% } %>

            <div class="comment-list" id="comment-list">
              <% if (!comments || comments.length === 0) { %>
                <article class="comment-item">
                  <p class="muted" style="margin:0;">Aun no hay comentarios. Se la primera persona en opinar.</p>
                </article>
              <% } %>

              <% (comments || []).forEach((comment) => { %>
                <article class="comment-item">
                  <div class="comment-header">
                    <div class="comment-avatar"><%= ((comment.user && comment.user.name) ? comment.user.name.charAt(0) : '?').toUpperCase() %></div>
                    <span class="comment-author"><%= (comment.user && comment.user.name) ? comment.user.name : 'Usuario' %></span>
                    <span class="comment-date"><%= new Date(comment.createdAt).toLocaleDateString('es-MX') %></span>
                  </div>
                  <p class="comment-text"><%= comment.commentText %></p>
                </article>
              <% }); %>
            </div>
          </section>
        <% } %>

        <%- include("../partials/footer") %>
      </main>
    </div>

    <script src="/js/recipes.js"></script>
  </body>
</html>
