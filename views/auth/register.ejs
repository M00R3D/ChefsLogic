<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="auth-shell">
      <div class="auth-card">
        <p class="auth-brand">Chef's Logic</p>
        <h2>Crea tu cuenta</h2>
        <p class="auth-subtitle">Únete para guardar recetas, comentar y publicar</p>

        <% if (errorMessage) { %>
          <div class="alert alert-error"><%= errorMessage %></div>
        <% } %>

        <form class="form-grid" action="/register" method="POST">
          <label>
            Nombre completo
            <input type="text" name="name" placeholder="María García" required autocomplete="name" />
          </label>

          <label>
            Email
            <input type="email" name="email" placeholder="chef@ejemplo.com" required autocomplete="email" />
          </label>

          <label>
            Contraseña
            <input type="password" name="password" placeholder="Mínimo 8 caracteres" required autocomplete="new-password" />
          </label>

          <label>
            Confirmar contraseña
            <input type="password" name="confirmPassword" placeholder="Repite tu contraseña" required autocomplete="new-password" />
          </label>

          <button class="btn btn-primary" type="submit" style="width:100%;justify-content:center;margin-top:0.25rem;">
            Crear cuenta
          </button>
        </form>

        <p class="auth-footer">
          ¿Ya tienes cuenta? <a href="/login">Ingresar</a>
        </p>
      </div>
    </div>

    <div class="toast-root" id="toast-root"></div>
    <script src="/js/app-ui.js"></script>
  </body>
</html>
