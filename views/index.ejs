<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="app-shell">
      <%- include("partials/navbar", { activeTab }) %>

      <main class="main-content">
        <section class="explore-hero reveal">
          <h1>Descubre Sabor de Origen</h1>
          <p>
            Un recetario vivo donde cada plato cuenta una historia. Filtra por region,
            guarda favoritos y comparte tus propias recetas.
          </p>
          <div class="actions" style="justify-content:center;">
            <a class="btn btn-primary" href="/recipes">Ir al recetario</a>
            <% if (typeof currentUser !== 'undefined' && currentUser) { %>
              <a class="btn btn-outline" href="/recipes/create">Publicar receta</a>
            <% } else { %>
              <a class="btn btn-outline" href="/register">Crear cuenta gratis</a>
            <% } %>
          </div>
        </section>

        <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
          <section class="alert alert-warning"><%= errorMessage %></section>
        <% } %>

        <section class="filter-pills" id="region-pills">
          <button class="pill active" type="button" data-region="all">Todas las regiones</button>
          <% (typeof regions !== 'undefined' && Array.isArray(regions) ? regions : []).forEach((region) => { %>
            <button class="pill" type="button" data-region="<%= String(region._id) %>"><%= region.name %></button>
          <% }); %>
        </section>

        <section class="section-heading">
          <h2>Recetas Publicadas</h2>
          <a class="btn btn-ghost btn-sm" href="/recipes">Ver todo</a>
        </section>

        <section class="grid cols-3" id="recipes-grid">
          <% if (typeof recipes === 'undefined' || !recipes || recipes.length === 0) { %>
            <article class="card">
              <p class="muted">Aun no hay recetas publicadas. Se la primera persona en compartir una.</p>
            </article>
          <% } %>

          <% (typeof recipes !== 'undefined' && Array.isArray(recipes) ? recipes : []).forEach((recipe, index) => { %>
            <article
              class="recipe-card reveal"
              data-region="<%= recipe.region ? String(recipe.region._id) : 'none' %>"
              data-reveal-index="<%= index %>"
            >
              <button
                class="recipe-card-save-btn <%= (typeof currentUser !== 'undefined' && currentUser && Array.isArray(currentUser.savedRecipes) && currentUser.savedRecipes.some((id) => String(id) === String(recipe._id))) ? 'saved' : '' %>"
                type="button"
                title="Guardar receta"
                data-recipe-save="<%= recipe._id %>"
              >
                ❤
              </button>

              <% if (recipe.imageUrl) { %>
                <img class="recipe-card-img" src="<%= recipe.imageUrl %>" alt="<%= recipe.title %>" loading="lazy" />
              <% } else { %>
                <div class="recipe-card-img-placeholder">🍲</div>
              <% } %>

              <div class="recipe-card-body">
                <p class="recipe-card-meta"><%= recipe.region ? recipe.region.name : 'Sin region' %></p>
                <h3 class="recipe-card-title"><a href="/recipes/<%= recipe._id %>"><%= recipe.title %></a></h3>
                <div class="recipe-card-footer">
                  <span>⏱ <%= recipe.prepMinutes + recipe.cookMinutes %> min</span>
                  <span>❤ <%= recipe.likeCount || 0 %></span>
                  <span>🍽 <%= recipe.servings || 1 %></span>
                </div>
              </div>
            </article>
          <% }); %>
        </section>

        <%- include("partials/footer") %>
      </main>
    </div>

    <script src="/js/recipes.js"></script>
    <script>
      const pills = document.querySelectorAll('#region-pills .pill');
      const cards = document.querySelectorAll('#recipes-grid .recipe-card');

      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          pills.forEach((item) => item.classList.remove('active'));
          pill.classList.add('active');

          const selected = pill.dataset.region;
          cards.forEach((card) => {
            const region = card.dataset.region;
            card.style.display = selected === 'all' || region === selected ? '' : 'none';
          });
        });
      });
    </script>
  </body>
</html>
