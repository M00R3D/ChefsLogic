<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="app-shell">
      <%- include("../partials/navbar", { activeTab }) %>

      <main class="main-content">
        <section class="section-heading">
          <h2>My Recipe Book</h2>
          <div class="actions">
            <a class="btn btn-primary" href="/recipes/create">+ Nueva receta</a>
          </div>
        </section>

        <% if (errorMessage) { %>
          <section class="alert alert-error"><%= errorMessage %></section>
        <% } %>

        <section class="card" style="margin-bottom:1.25rem;">
          <p class="muted" style="margin:0;">
            Una coleccion curada de tus recetas favoritas, experimentos culinarios y sabores heredados.
          </p>
        </section>

        <section class="grid cols-3">
          <% if (!recipes || recipes.length === 0) { %>
            <article class="card">
              <p class="muted">No hay recetas registradas aun.</p>
            </article>
          <% } %>

          <% recipes.forEach((recipe, index) => { %>
            <% const imageCandidate = String(recipe.imageUrl || recipe.imagen_principal || '').trim(); %>
            <% const canRenderImage = /^(https?:\/\/|\/|data:image\/)/i.test(imageCandidate); %>
            <% const currentId = typeof currentUser !== 'undefined' && currentUser ? String(currentUser._id) : ''; %>
            <% const ownerId = String(recipe.author || recipe.usuario_id || ''); %>
            <% const isAdmin = typeof currentUser !== 'undefined' && currentUser && String(currentUser.role || '').toLowerCase() === 'admin'; %>
            <% const canEditRecipe = Boolean(currentUser && (isAdmin || (currentId && ownerId && currentId === ownerId))); %>
            <%
              const safeHexIdx = /^#[0-9a-fA-F]{3,6}$/.test(String(recipe.accentColor||'')) ? recipe.accentColor : '';
              const diffColIdx = { facil: '#27ae60', media: '#e67e22', dificil: '#c0392b' };
              const cardAccent = safeHexIdx || diffColIdx[String(recipe.difficulty||'media')] || '#546e7a';
              const cardEmoji = String(recipe.fallbackEmoji||'').trim() || '🍳';
            %>
            <article class="recipe-card reveal" data-reveal-index="<%= index %>">
              <% if (imageCandidate && canRenderImage) { %>
                <img class="recipe-card-img" src="<%= imageCandidate %>" alt="<%= recipe.title || recipe.titulo || 'Receta' %>" loading="lazy" />
              <% } else { %>
                <div class="recipe-card-img-accent" style="--card-accent:<%= cardAccent %>">
                  <span class="recipe-card-img-emoji"><%= cardEmoji %></span>
                </div>
              <% } %>

              <div class="recipe-card-body">
                <p class="recipe-card-meta"><%= recipe.region ? recipe.region.name : 'Sin region' %></p>
                <h3 class="recipe-card-title">
                  <a href="/recipes/<%= recipe._id %>"><%= recipe.title || recipe.titulo || "Sin titulo" %></a>
                </h3>

                <div class="actions" style="margin-bottom:0.65rem;">
                  <span class="status-badge <%= recipe.status || 'borrador' %>"><%= recipe.status || 'borrador' %></span>
                  <span class="chip"><%= recipe.difficulty || recipe.dificultad || 'media' %></span>
                </div>

                <div class="recipe-card-footer" style="margin-bottom:0.75rem;">
                  <span>⏱ <%= (recipe.prepMinutes || 0) + (recipe.cookMinutes || 0) %> min</span>
                  <span>❤ <%= recipe.likeCount || 0 %></span>
                  <span>🍽 <%= recipe.servings || 1 %></span>
                </div>

                <div class="actions">
                  <a class="btn btn-soft btn-sm" href="/recipes/<%= recipe._id %>">Ver</a>
                  <% if (canEditRecipe) { %>
                    <a class="btn btn-soft btn-sm" href="/recipes/<%= recipe._id %>/edit">Editar</a>
                    <button class="btn btn-danger btn-sm" data-delete-recipe="<%= recipe._id %>">Eliminar</button>
                  <% } %>
                </div>
              </div>
            </article>
          <% }); %>
        </section>

        <%- include("../partials/footer") %>
      </main>
    </div>

    <script src="/js/recipes.js"></script>
  </body>
</html>
