<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="app-shell">
      <%- include("partials/navbar", { activeTab }) %>

      <main class="main-content">
        <%
          const safeStats = (typeof stats !== 'undefined' && stats) ? stats : { recipes: 0, ingredients: 0, cookbooks: 0 };
          const safeFeaturedCookbooks = (typeof featuredCookbooks !== 'undefined' && Array.isArray(featuredCookbooks)) ? featuredCookbooks : [];
          const safeRecentIngredients = (typeof recentIngredients !== 'undefined' && Array.isArray(recentIngredients)) ? recentIngredients : [];

          const HOME_THEME_META = {
            mexicana:      { emoji: '🇲🇽', color: '#c0392b', bg: '#fdedec', label: 'Mexicana' },
            postres:       { emoji: '🍮', color: '#d35400', bg: '#fef5e7', label: 'Postres' },
            bebidas:       { emoji: '🍹', color: '#2980b9', bg: '#eaf4fc', label: 'Bebidas' },
            vegano:        { emoji: '🌱', color: '#27ae60', bg: '#e9f7ef', label: 'Vegano' },
            mariscos:      { emoji: '🦐', color: '#1a6e8e', bg: '#e8f6f9', label: 'Mariscos' },
            antojitos:     { emoji: '🫔', color: '#e67e22', bg: '#fdf2e9', label: 'Antojitos' },
            sopas:         { emoji: '🍲', color: '#8e44ad', bg: '#f5eef8', label: 'Sopas' },
            desayunos:     { emoji: '🍳', color: '#f39c12', bg: '#fef9e7', label: 'Desayunos' },
            carnes:        { emoji: '🥩', color: '#922b21', bg: '#fdedec', label: 'Carnes' },
            internacional: { emoji: '🌍', color: '#2c3e50', bg: '#f2f3f4', label: 'Internacional' },
            otro:          { emoji: '📖', color: '#546e7a', bg: '#f5f5f5', label: 'Otro' }
          };
          function homeTheme(theme) {
            return HOME_THEME_META[String(theme || 'otro').toLowerCase()] || HOME_THEME_META.otro;
          }
          function cookbookSymbol(cookbook) {
            const rawManual = String(cookbook.coverEmoji || '').trim();
            if (rawManual) return rawManual;
            const text = `${cookbook.title || cookbook.nombre || ''} ${(cookbook.tags || []).join(' ')}`.toLowerCase();
            if (/taco|taquer|pastor|barbacoa|cochinita|quesabirria/.test(text)) return '🌮';
            if (/sopa|caldo|consome|menudo|pozole/.test(text)) return '🍲';
            if (/postre|dulce|pastel|flan|gelatina|pay|pan/.test(text)) return '🍮';
            if (/desayuno|huevo|hotcake|chilaquil|avena/.test(text)) return '🍳';
            if (/bebida|cafe|atole|chocolate|agua|coctel|licuado/.test(text)) return '🍹';
            if (/marisco|camaron|atun|pescado|ceviche/.test(text)) return '🦐';
            if (/ensalada|veg|verdura|tofu|plant|fit/.test(text)) return '🌱';
            if (/carne|res|cerdo|pollo|asado|costilla/.test(text)) return '🥩';
            if (/antojito|tamal|gordita|sopes|tlayuda|flauta/.test(text)) return '🫔';
            return homeTheme(cookbook.theme).emoji;
          }
        %>

        <section class="explore-hero reveal">
          <h1>Descubre Sabor de Origen</h1>
          <p>
            Un recetario vivo donde cada plato cuenta una historia.
            Explora recetas, ingredientes y recetarios desde un solo lugar.
          </p>
          <div class="actions" style="justify-content:center;">
            <a class="btn btn-primary" href="/recipes">Ir al recetario</a>
            <a class="btn btn-soft" href="/cookbooks">Ver recetarios</a>
            <% if (typeof currentUser !== 'undefined' && currentUser) { %>
              <a class="btn btn-outline" href="/recipes/create">Publicar receta</a>
            <% } else { %>
              <a class="btn btn-outline" href="/register">Crear cuenta gratis</a>
            <% } %>
          </div>
        </section>

        <section class="home-kpi-grid reveal">
          <article class="home-kpi-card">
            <p class="home-kpi-label">Recetas</p>
            <p class="home-kpi-value"><%= (safeStats && typeof safeStats.recipes !== 'undefined') ? safeStats.recipes : 0 %></p>
            <a class="btn btn-ghost btn-sm" href="/recipes">Ver catálogo</a>
          </article>
          <article class="home-kpi-card">
            <p class="home-kpi-label">Ingredientes</p>
            <p class="home-kpi-value"><%= (safeStats && typeof safeStats.ingredients !== 'undefined') ? safeStats.ingredients : 0 %></p>
            <a class="btn btn-ghost btn-sm" href="/ingredients">Ver catálogo</a>
          </article>
          <article class="home-kpi-card">
            <p class="home-kpi-label">Recetarios</p>
            <p class="home-kpi-value"><%= (safeStats && typeof safeStats.cookbooks !== 'undefined') ? safeStats.cookbooks : 0 %></p>
            <a class="btn btn-ghost btn-sm" href="/cookbooks">Ver catálogo</a>
          </article>
        </section>

        <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
          <section class="alert alert-warning"><%= errorMessage %></section>
        <% } %>

        <section class="filter-pills" id="region-pills">
          <button class="pill active" type="button" data-region="all">Todas las regiones</button>
          <% (typeof regions !== 'undefined' && Array.isArray(regions) ? regions : []).forEach((region) => { %>
            <button class="pill" type="button" data-region="<%= String(region._id) %>"><%= region.name || region.nombre || 'Region' %></button>
          <% }); %>
        </section>

        <section class="section-heading">
          <h2>Recetas Publicadas</h2>
          <a class="btn btn-ghost btn-sm" href="/recipes">Ver todo</a>
        </section>

        <section class="grid cols-3" id="recipes-grid">
          <% if (typeof recipes === 'undefined' || !recipes || recipes.length === 0) { %>
            <article class="card">
              <p class="muted">Aun no hay recetas publicadas. Se la primera persona en compartir una.</p>
            </article>
          <% } %>

          <% (typeof recipes !== 'undefined' && Array.isArray(recipes) ? recipes : []).forEach((recipe, index) => { %>
            <article
              class="recipe-card reveal"
              data-region="<%= recipe.region ? String(recipe.region._id) : 'none' %>"
              data-reveal-index="<%= index %>"
            >
              <button
                class="recipe-card-save-btn <%= (typeof currentUser !== 'undefined' && currentUser && Array.isArray(currentUser.savedRecipes) && currentUser.savedRecipes.some((id) => String(id) === String(recipe._id))) ? 'saved' : '' %>"
                type="button"
                title="Guardar receta"
                data-recipe-save="<%= recipe._id %>"
              >
                ❤
              </button>

              <% const imageCandidate = String(recipe.imageUrl || recipe.imagen_principal || '').trim(); %>
              <% const canRenderImage = /^(https?:\/\/|\/|data:image\/)/i.test(imageCandidate); %>
              <% const recipeName = String(recipe.title || recipe.titulo || '').toLowerCase(); %>
              <% const recipeTags = Array.isArray(recipe.tags) ? recipe.tags.join(' ').toLowerCase() : ''; %>
              <% const placeholderEmoji = /\bsal\b/i.test(`${recipeName} ${recipeTags}`) ? '🌮🧂' : '🌮🦐'; %>
              <% if (imageCandidate && canRenderImage) { %>
                <img
                  class="recipe-card-img"
                  src="<%= imageCandidate %>"
                  alt="<%= recipe.title || recipe.titulo || 'Sin titulo' %>"
                  loading="lazy"
                />
              <% } else { %>
                <div class="recipe-card-img-placeholder"><%= placeholderEmoji %></div>
              <% } %>

              <div class="recipe-card-body">
                <p class="recipe-card-meta"><%= recipe.region ? (recipe.region.name || recipe.region.nombre || 'Sin region') : 'Sin region' %></p>
                <h3 class="recipe-card-title">
                  <a href="/recipes/<%= recipe._id %>"><%= recipe.title || recipe.titulo || 'Sin titulo' %></a>
                </h3>
                <div class="recipe-card-footer">
                  <span>⏱ <%= (recipe.prepMinutes || recipe.tiempo_preparacion || 0) + (recipe.cookMinutes || 0) %> min</span>
                  <span>❤ <%= (recipe.likeCount || recipe.likes || 0) %></span>
                  <span>🍽 <%= recipe.servings || 1 %></span>
                </div>
              </div>
            </article>
          <% }); %>
        </section>

        <section class="section-heading">
          <h2>Recetarios Recientes</h2>
          <a class="btn btn-ghost btn-sm" href="/cookbooks">Ver todo</a>
        </section>

        <section class="grid cols-3 cb-cards-grid">
          <% if (!safeFeaturedCookbooks.length) { %>
            <article class="card">
              <p class="muted">Aún no hay recetarios publicados.</p>
            </article>
          <% } %>

          <% safeFeaturedCookbooks.forEach((cb, idx) => { %>
            <% const tMeta = homeTheme(cb.theme); %>
            <% const img = String(cb.coverImage || '').trim(); %>
            <% const canImg = /^(https?:\/\/|\/|data:image\/)/i.test(img); %>
            <% const hex = /^#[0-9a-fA-F]{3,6}$/.test(String(cb.accentColor || '')) ? cb.accentColor : ''; %>
            <% const accent = hex || tMeta.color; %>
            <% const symbol = cookbookSymbol(cb); %>
            <% const rCount = (cb.recipes || cb.recetas || []).length; %>

            <article class="cb-card reveal" data-reveal-index="<%= idx %>" style="--cb-accent:<%= accent %>">
              <div class="cb-card-cover">
                <% if (img && canImg) { %>
                  <img class="cb-card-cover-img" src="<%= img %>" alt="<%= cb.title || cb.nombre || 'Recetario' %>" loading="lazy" />
                  <div class="cb-card-cover-overlay"></div>
                <% } else { %>
                  <div class="cb-card-cover-placeholder"></div>
                <% } %>

                <span class="cb-card-emoji"><%= symbol %></span>
                <div class="cb-card-cover-badges">
                  <span class="cb-theme-badge" style="--pill-color:<%= tMeta.color %>;--pill-bg:<%= tMeta.bg %>">
                    <%= tMeta.emoji %> <%= tMeta.label %>
                  </span>
                </div>
              </div>

              <div class="cb-card-body">
                <h3 class="cb-card-title"><%= cb.title || cb.nombre || 'Sin título' %></h3>
                <p class="muted cb-card-desc"><%= rCount %> receta<%= rCount !== 1 ? 's' : '' %></p>
                <div class="actions" style="margin-top:.4rem;">
                  <a class="btn btn-soft btn-sm" href="/cookbooks/<%= cb._id %>">Ver recetario</a>
                </div>
              </div>
            </article>
          <% }); %>
        </section>

        <section class="section-heading">
          <h2>Ingredientes Nuevos</h2>
          <a class="btn btn-ghost btn-sm" href="/ingredients">Ver todo</a>
        </section>

        <section class="home-ingredient-strip">
          <% if (!safeRecentIngredients.length) { %>
            <article class="card">
              <p class="muted">Aún no hay ingredientes registrados.</p>
            </article>
          <% } %>

          <% safeRecentIngredients.forEach((ing) => { %>
            <article class="home-ingredient-chip">
              <strong><%= ing.name || ing.nombre || 'Ingrediente' %></strong>
              <span><%= ing.category || ing.categoria || 'otro' %></span>
            </article>
          <% }); %>
        </section>

        <% if (typeof userHomeStats !== 'undefined' && userHomeStats) { %>
        <section class="section-heading" style="margin-top:2rem;">
          <div>
            <h2>Mi resumen <span style="font-size:1rem;font-weight:400;color:var(--text-soft)">(últimos 30 días)</span></h2>
            <p style="margin:0;color:var(--text-soft)">Actividad sobre tus recetas</p>
          </div>
          <a class="btn btn-soft btn-sm" href="/mi-dashboard">Ver mi dashboard completo →</a>
        </section>

        <div class="dashboard-summary-grid" style="margin-bottom:1rem;grid-template-columns:repeat(4,minmax(0,1fr));">
          <div class="card dashboard-small-card">
            <h4>Mis recetas</h4>
            <p class="big-number"><%= userHomeStats.totalMyRecipes %></p>
          </div>
          <div class="card dashboard-small-card">
            <h4>Visitas</h4>
            <p class="big-number"><%= userHomeStats.visitas %></p>
          </div>
          <div class="card dashboard-small-card">
            <h4>Likes recibidos</h4>
            <p class="big-number"><%= userHomeStats.likes %></p>
          </div>
          <div class="card dashboard-small-card">
            <h4>Guardados</h4>
            <p class="big-number"><%= userHomeStats.guardados %></p>
          </div>
        </div>

        <div class="grid cols-3" style="gap:1rem;margin-bottom:1.5rem;">
          <div class="card dashboard-list-card">
            <h3>Más vistas</h3>
            <ol>
              <% (userHomeStats.topViewed||[]).forEach(function(r){ %><li><strong><%= r.title %></strong> — <%= r.total %> visitas</li><% }); %>
              <% if (!(userHomeStats.topViewed||[]).length) { %><li style="color:var(--text-muted)">Sin datos aún</li><% } %>
            </ol>
          </div>
          <div class="card dashboard-list-card">
            <h3>Más gustadas</h3>
            <ol>
              <% (userHomeStats.topLiked||[]).forEach(function(r){ %><li><%= r.title %> — <%= r.total %> likes</li><% }); %>
              <% if (!(userHomeStats.topLiked||[]).length) { %><li style="color:var(--text-muted)">Sin datos aún</li><% } %>
            </ol>
          </div>
          <div class="card dashboard-list-card">
            <h3>Más guardadas</h3>
            <ol>
              <% (userHomeStats.topSaved||[]).forEach(function(r){ %><li><%= r.title %> — <%= r.total %> guardados</li><% }); %>
              <% if (!(userHomeStats.topSaved||[]).length) { %><li style="color:var(--text-muted)">Sin datos aún</li><% } %>
            </ol>
          </div>
        </div>
        <% } %>

        <%- include("partials/footer") %>

    <script src="/js/recipes.js"></script>
    <script>
      const pills = document.querySelectorAll('#region-pills .pill');
      const cards = document.querySelectorAll('#recipes-grid .recipe-card');

      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          pills.forEach((item) => item.classList.remove('active'));
          pill.classList.add('active');

          const selected = pill.dataset.region;
          cards.forEach((card) => {
            const region = card.dataset.region;
            card.style.display = selected === 'all' || region === selected ? '' : 'none';
          });
        });
      });
    </script>
  </body>
</html>
