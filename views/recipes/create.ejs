<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="app-shell">
      <%- include("../partials/navbar", { activeTab }) %>

      <main class="main-content">
        <%- include("../partials/header", { pageTitle: "Create New Recipe" }) %>

        <section class="create-steps card" style="margin-bottom:1rem;">
          <div class="step-pill is-active"><span>1</span> Basicos</div>
          <div class="step-line"></div>
          <div class="step-pill"><span>2</span> Ingredientes</div>
          <div class="step-line"></div>
          <div class="step-pill"><span>3</span> Instrucciones</div>
        </section>

        <section class="grid cols-2">
          <article class="card reveal">
            <% if (errorMessage) { %>
              <div class="alert alert-error"><%= errorMessage %></div>
            <% } %>

            <form id="recipe-form" class="form-grid" action="/recipes" method="POST">
              <div class="form-grid cols-2">
                <label>
                  Titulo
                  <input type="text" name="title" required placeholder="Ej. Mole negro tradicional" />
                </label>
                <label>
                  Slug (opcional)
                  <input type="text" name="slug" placeholder="mole-negro-tradicional" />
                </label>
              </div>

              <label>
                Resumen
                <textarea name="summary" placeholder="Cuenta el origen o historia de tu receta"></textarea>
              </label>

              <!-- IMAGE UPLOAD -->
              <div class="image-upload-block">
                <span class="form-label">Imagen principal</span>
                <div class="image-drop-zone" id="image-drop-zone">
                  <input type="file" id="image-file-input" accept="image/jpeg,image/png,image/webp,image/gif" style="display:none" />
                  <div class="drop-zone-inner" id="drop-zone-inner">
                    <span class="drop-icon">📷</span>
                    <span class="drop-text">Arrastra aquí o <span class="drop-link" id="drop-link">selecciona archivo</span></span>
                    <span class="drop-hint">JPG · PNG · WebP · máx 5 MB</span>
                  </div>
                  <img id="image-preview" class="image-preview-thumb" style="display:none" alt="Vista previa" />
                </div>
                <div class="image-url-row">
                  <span class="form-help">O pega una URL:</span>
                  <input type="url" name="imageUrl" id="image-url-input" placeholder="https://..." />
                </div>
              </div>

              <div class="form-grid cols-2">
                <label>
                  Region
                  <select name="region">
                    <option value="">Sin region</option>
                    <% regions.forEach((region) => { %>
                      <option value="<%= region._id %>"><%= region.name %></option>
                    <% }); %>
                  </select>
                </label>
                <label>
                  Dificultad
                  <select name="difficulty">
                    <option value="facil">Facil</option>
                    <option value="media" selected>Media</option>
                    <option value="dificil">Dificil</option>
                  </select>
                </label>
              </div>

              <div class="form-grid cols-2">
                <label>
                  Min. preparacion
                  <input type="number" name="prepMinutes" min="0" value="10" />
                </label>
                <label>
                  Min. coccion
                  <input type="number" name="cookMinutes" min="0" value="20" />
                </label>
              </div>

              <div class="form-grid cols-2">
                <label>
                  Porciones
                  <input type="number" name="servings" min="1" value="2" />
                </label>
                <label>
                  Estado
                  <select name="status">
                    <option value="borrador" selected>Borrador</option>
                    <option value="publicada">Publicada</option>
                    <option value="archivada">Archivada</option>
                  </select>
                </label>
              </div>

              <label>
                Etiquetas (separadas por coma)
                <input type="text" name="tags" placeholder="mexicana, fuego lento, tradicional" />
              </label>

              <!-- INGREDIENT PICKER -->
              <div class="ing-picker">
                <span class="form-label">Ingredientes</span>
                <div class="ing-cat-pills" id="ing-cat-pills"></div>
                <input type="text" id="ing-search" class="ing-search" placeholder="Buscar ingrediente..." autocomplete="off" />
                <div class="ing-catalog" id="ing-catalog"></div>
                <div class="ing-selected" id="ing-selected"></div>
                <textarea name="ingredientsData" id="ing-data" style="display:none"></textarea>
              </div>

              <!-- STEP BUILDER -->
              <div class="step-builder">
                <span class="form-label">Pasos de preparacion</span>
                <ol class="steps-list-builder" id="steps-list"></ol>
                <div class="step-nodes-wrap" id="step-nodes-wrap"></div>
                <button type="button" class="btn btn-soft btn-sm add-step-btn" id="add-step-btn">
                  &#65291;&nbsp;Agregar paso
                </button>
                <textarea name="stepsData" id="steps-data" style="display:none"></textarea>
              </div>

              <div class="actions">
                <button class="btn btn-primary" type="submit">Publicar receta</button>
                <a class="btn btn-soft" href="/recipes">Cancelar</a>
              </div>
            </form>
          </article>

          <aside class="card reveal">
            <h3>Vista previa</h3>
            <div id="recipe-preview" class="muted"></div>
            <p class="form-help">La previsualizacion se actualiza en tiempo real mientras escribes.</p>
          </aside>
        </section>

        <%- include("../partials/footer") %>
      </main>
    </div>

    <script id="ingredients-data" type="application/json"><%- JSON.stringify(allIngredients || []) %></script>
    <script src="/js/forms.js"></script>
  </body>
</html>
