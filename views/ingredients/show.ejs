<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="app-shell">
      <%- include("../partials/navbar", { activeTab }) %>

      <main class="main-content">
        <%- include("../partials/header", { pageTitle: ingredient ? (ingredient.name || ingredient.nombre || "Detalle de ingrediente") : "Detalle de ingrediente" }) %>

        <% if (errorMessage || !ingredient) { %>
          <section class="card">
            <p class="muted"><%= errorMessage || "No se pudo cargar el ingrediente." %></p>
            <a class="btn btn-soft" href="/ingredients">Volver a ingredientes</a>
          </section>
        <% } %>

        <% if (ingredient) { %>
          <%
            const ING_META = {
              verdura:    { emoji: '🥦', color: '#2e7d32', bg: '#e8f5e9', label: 'Verdura' },
              fruta:      { emoji: '🍎', color: '#c62828', bg: '#ffebee', label: 'Fruta' },
              proteina:   { emoji: '🥩', color: '#b71c1c', bg: '#fff3e0', label: 'Proteina' },
              grano:      { emoji: '🌾', color: '#6d4c41', bg: '#efebe9', label: 'Grano' },
              especia:    { emoji: '🌶️', color: '#e65100', bg: '#fff8e1', label: 'Especia' },
              lacteo:     { emoji: '🧀', color: '#1565c0', bg: '#e3f2fd', label: 'Lacteo' },
              aceite:     { emoji: '🫙', color: '#5c4a1e', bg: '#fef9e7', label: 'Aceite' },
              condimento: { emoji: '🥫', color: '#7b341e', bg: '#fdf2e8', label: 'Condimento' },
              chile:      { emoji: '🌶️', color: '#c0392b', bg: '#fdedec', label: 'Chile' },
              salsa:      { emoji: '🍅', color: '#e74c3c', bg: '#fef5f5', label: 'Salsa' },
              bebida:     { emoji: '🫗', color: '#2980b9', bg: '#eaf4fc', label: 'Bebida' },
              conserva:   { emoji: '🥃', color: '#7d6608', bg: '#fdfce6', label: 'Conserva' },
              hongo:      { emoji: '🍄', color: '#6e4b7b', bg: '#f4edf7', label: 'Hongo' },
              otro:       { emoji: '🧺', color: '#546e7a', bg: '#f5f5f5', label: 'Otro' }
            };
            const category = String(ingredient.category || ingredient.categoria || 'otro').toLowerCase();
            const meta = ING_META[category] || ING_META.otro;
            const ni = ingredient.nutritionalInfo || {};
            const tags = Array.isArray(ingredient.tags) ? ingredient.tags : [];
            const seasonality = Array.isArray(ingredient.seasonality) ? ingredient.seasonality : [];
            const seasonalitySet = new Set(seasonality);
            const allMonths = [
              { key: 'enero', label: 'Ene' },
              { key: 'febrero', label: 'Feb' },
              { key: 'marzo', label: 'Mar' },
              { key: 'abril', label: 'Abr' },
              { key: 'mayo', label: 'May' },
              { key: 'junio', label: 'Jun' },
              { key: 'julio', label: 'Jul' },
              { key: 'agosto', label: 'Ago' },
              { key: 'septiembre', label: 'Sep' },
              { key: 'octubre', label: 'Oct' },
              { key: 'noviembre', label: 'Nov' },
              { key: 'diciembre', label: 'Dic' }
            ];
            const accessibilityLabels = {
              economico: 'Económico',
              medio: 'Precio medio',
              premium: 'Premium'
            };
            const accessibilityKey = String(ingredient.accesibilidad || 'medio').toLowerCase();
            const accessibilityLabel = accessibilityLabels[accessibilityKey] || 'Precio medio';
          %>

          <section class="card reveal" style="border-top: 4px solid <%= meta.color %>;">
            <div class="ing-card-detail-header" style="margin-bottom: .7rem;">
              <span class="ing-card-detail-emoji" style="background:<%= meta.bg %>;color:<%= meta.color %>"><%= meta.emoji %></span>
              <div class="ing-card-detail-info">
                <h1 class="recipe-title" style="margin:0;"><%= ingredient.name || ingredient.nombre || 'Ingrediente' %></h1>
                <span class="ing-cat-badge" style="margin-top:.35rem;"><%= meta.label %></span>
              </div>
              <span class="ing-unit-badge"><%= ingredient.defaultUnit || ingredient.unidad || 'g' %></span>
            </div>

            <div class="recipe-meta-row" style="margin-bottom:.7rem;">
              <span class="chip">Unidad base: <%= ingredient.defaultUnit || ingredient.unidad || 'g' %></span>
              <span class="chip">Accesibilidad: <%= accessibilityLabel %></span>
              <span class="chip">Precio aprox: <%= typeof ingredient.precio_aprox !== 'undefined' ? ingredient.precio_aprox : 0 %></span>
            </div>

            <h3 style="margin-bottom:.45rem;">Etiquetas</h3>
            <div class="ing-card-tags" style="margin-bottom:.75rem;">
              <% if (tags.length) { %>
                <% tags.forEach((tag) => { %>
                  <a class="ing-tag-chip" href="/ingredients?tag=<%= encodeURIComponent(tag) %>&page=1"><%= tag %></a>
                <% }); %>
              <% } else { %>
                <span class="ing-tag-chip ing-tag-chip-empty">Sin etiquetas</span>
              <% } %>
            </div>

            <h3 style="margin-bottom:.45rem;">Informacion nutricional</h3>
            <div class="ing-nutrition-row" style="margin-bottom:.7rem;">
              <span class="ing-nutr-chip">🔥 <%= Number(ni.calories || 0) %> kcal</span>
              <span class="ing-nutr-chip">💪 <%= Number(ni.protein || 0) %>g proteina</span>
              <span class="ing-nutr-chip">🌾 <%= Number(ni.carbs || 0) %>g carbohidratos</span>
              <span class="ing-nutr-chip">🧈 <%= Number(ni.fat || 0) %>g grasa</span>
            </div>

            <h3 style="margin-bottom:.45rem;">Temporada</h3>
            <div class="ing-season-row" style="margin-bottom:.35rem;">
              <% allMonths.forEach((month) => { %>
                <span class="ing-season-chip <%= seasonalitySet.has(month.key) ? 'is-active' : 'is-empty' %>"><%= month.label %></span>
              <% }); %>
            </div>
            <p class="form-help" style="margin-top:0;margin-bottom:.7rem;">
              <% if (seasonality.length) { %>
                Disponible en: <%= seasonality.join(', ') %>
              <% } else { %>
                No se registró estacionalidad.
              <% } %>
            </p>

            <div class="actions" style="margin-top:.5rem;">
              <a class="btn btn-soft" href="/ingredients">Volver a ingredientes</a>
              <% if (typeof currentUser !== 'undefined' && currentUser && String(currentUser.role || '').toLowerCase() === 'admin') { %>
                <a class="btn btn-ghost" href="/ingredients/moderation">Ir a moderacion</a>
                <button class="btn btn-danger" data-delete-ingredient="<%= ingredient._id %>">Eliminar ingrediente</button>
              <% } %>
            </div>
          </section>
        <% } %>

        <%- include("../partials/footer") %>
      </main>
    </div>
  </body>
</html>
