<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    
    <div class="app-shell">
      <%- include("partials/navbar", { activeTab }) %>
      <main class="main-content">
        <section class="section-heading">
          <div>
            <h2>Dashboard administrativo</h2>
            <p>Resumen detallado de usuarios, recetas y eventos con filtros por período.</p>
          </div>
        </section>

        <div class="filter-pills" style="margin-bottom:1rem;">
          <% ['today', '7', '30', 'year'].forEach(function(key) { %>
            <a class="pill <%= rangeKey === key ? 'active' : '' %>" href="/admin/dashboard?range=<%= key %>"><%= key === 'today' ? 'Hoy' : key === '7' ? '7 días' : key === '30' ? '30 días' : 'Este año' %></a>
          <% }); %>
        </div>

        <div id="dashboard-notifications" style="margin-bottom:1rem;"></div>

        <% if (errorMessage) { %>
          <section class="alert alert-error"><%= errorMessage %></section>
        <% } %>

        <div class="card dashboard-small-card users-card" style="margin-bottom:1rem;position:relative;z-index:10;">
          <div class="metric-top">
            <span class="metric-icon">👥</span>
            <span class="metric-badge">
              +<%= newUsersInRange || 0 %>
              <%= rangeKey === 'today' ? 'hoy' : rangeKey === '7' ? '7d' : rangeKey === '30' ? '30d' : 'año' %>
            </span>
          </div>
          <h3>Total usuarios</h3>
          <p class="big-number"><%= totalUsers %></p>

          <div class="users-hover-preview">
            <div class="hover-preview-title">Nuevos registros</div>
            <ul>
              <% const shuffledUsers = (recentUsersInRange || []).sort(() => 0.5 - Math.random()).slice(0, 5); %>
              <% shuffledUsers.forEach(function(user) { %>
                <li>
                  <span class="user-dot"></span>
                  <span><%= user.name || user.nombre || 'Usuario' %></span>
                </li>
              <% }) %>
              <% if (!shuffledUsers.length) { %>
                <li class="empty-preview">No hay usuarios recientes</li>
              <% } %>
            </ul>
          </div>
        </div>

        <div class="dashboard-summary-grid" style="margin-bottom:1rem;">
          <div class="card dashboard-small-card">
            <div class="metric-top">
              <span class="metric-icon">📚</span>
              <span class="metric-badge">
                +<%= typeof newRecipesInRange !== 'undefined' ? newRecipesInRange : 0 %>
                <%= rangeKey === 'today' ? 'hoy' : rangeKey === '7' ? '7d' : rangeKey === '30' ? '30d' : 'año' %>
              </span>
            </div>
            <h3>Total recetas</h3>
            <p class="big-number"><%= typeof newRecipesInRange !== 'undefined' ? newRecipesInRange : totalRecipes %></p>
          </div>
          <div class="card dashboard-small-card">
            <div class="metric-top">
              <span class="metric-icon">🥕</span>
              <span class="metric-badge">
                +<%= typeof newIngredientsInRange !== 'undefined' ? newIngredientsInRange : 0 %>
                <%= rangeKey === 'today' ? 'hoy' : rangeKey === '7' ? '7d' : rangeKey === '30' ? '30d' : 'año' %>
              </span>
            </div>
            <h3>Total ingredientes</h3>
            <p class="big-number"><%= typeof newIngredientsInRange !== 'undefined' ? newIngredientsInRange : totalIngredients %></p>
          </div>
          <div class="card dashboard-small-card">
            <h3>Total eventos</h3>
            <p class="big-number"><%= totalEvents %></p>
          </div>
          <div class="card dashboard-small-card">
            <h3>Eventos <%= rangeLabel %></h3>
            <p class="big-number"><%= eventsInRange %></p>
          </div>
        </div>

        <div class="dashboard-event-grid" style="margin-bottom:1rem;">
          <div class="card dashboard-small-card">
            <div class="metric-label">Visitas</div>
            <p class="big-number"><%= eventSummary.ver_receta %></p>
            <p class="metric-description">Vistas de recetas en el periodo</p>
          </div>
          <div class="card dashboard-small-card">
            <div class="metric-label">Likes</div>
            <p class="big-number"><%= eventSummary.like %></p>
            <p class="metric-description">Reacciones positivas recibidas</p>
          </div>
          <div class="card dashboard-small-card">
            <div class="metric-label">Guardados</div>
            <p class="big-number"><%= eventSummary.guardar_receta %></p>
            <p class="metric-description">Recetas guardadas en favoritos</p>
          </div>
          <div class="card dashboard-small-card">
            <div class="metric-label">Búsquedas</div>
            <p class="big-number"><%= eventSummary.buscar_receta %></p>
            <p class="metric-description">Consultas de búsqueda realizadas</p>
          </div>
          <div class="card dashboard-small-card">
            <div class="metric-label">Creaciones</div>
            <p class="big-number"><%= eventSummary.crear_receta %></p>
            <p class="metric-description">Nuevas recetas, ingredientes y recetarios creados</p>
          </div>
        </div>

        <div class="card" style="margin-bottom:1rem;">
          <h3>Categorías populares</h3>
          <div style="position:relative;width:100%;height:320px;">
            <canvas id="categoriesChart" aria-label="Gráfico de categorías populares"></canvas>
          </div>
        </div>

        <div class="card" style="margin-bottom:1rem;">
          <h3>Interacciones del periodo</h3>
          <p class="chart-note">Distribución de acciones que muestran cómo interactúan los usuarios con la plataforma: visitas, likes, guardados, búsquedas y creaciones.</p>
          <div style="position:relative;width:100%;height:320px;">
            <canvas id="interactionChart" aria-label="Gráfico de interacciones del periodo"></canvas>
          </div>
        </div>

        <div class="grid cols-3" style="gap:1rem; margin-bottom:1rem;">
          <div class="card dashboard-list-card">
            <h3>Top recetas vistas</h3>
            <div style="position:relative;width:100%;height:220px;">
              <canvas id="topRecipesChart"></canvas>
            </div>
          </div>
          <div class="card dashboard-list-card">
            <h3>Top recetas por likes</h3>
            <div style="position:relative;width:100%;height:220px;">
              <canvas id="topLikesChart"></canvas>
            </div>
          </div>
          <div class="card dashboard-list-card">
            <h3>Usuarios más activos</h3>
            <div style="position:relative;width:100%;height:220px;">
              <canvas id="topUsersChart"></canvas>
            </div>
          </div>
        </div>

        <div class="grid cols-3" style="gap:1rem; margin-bottom:1rem;">
          <div class="card dashboard-list-card">
            <h3>Ingredientes más usados</h3>
            <div style="position:relative;width:100%;height:220px;">
              <canvas id="topIngredientsChart"></canvas>
            </div>
          </div>
          <div class="card dashboard-list-card">
            <h3>Regiones más visitadas</h3>
            <div style="position:relative;width:100%;height:220px;">
              <canvas id="regionViewsChart"></canvas>
            </div>
          </div>
          <div class="card dashboard-list-card">
            <h3>Recetas por usuario</h3>
            <div style="position:relative;width:100%;height:220px;">
              <canvas id="recipesByUserChart"></canvas>
            </div>
          </div>
        </div>

        <div class="grid cols-2" style="gap:1rem; margin-bottom:1rem;">
          <div class="card dashboard-list-card">
            <h3>Recetas más guardadas</h3>
            <div style="position:relative;width:100%;height:220px;">
              <canvas id="topSavedChart"></canvas>
            </div>
          </div>
          <div class="card dashboard-list-card">
            <h3>Recetarios más populares</h3>
            <div style="position:relative;width:100%;height:220px;">
              <canvas id="topCookbooksChart"></canvas>
            </div>
          </div>
        </div>

        <div class="grid cols-2" style="gap:1rem; margin-bottom:1rem;">
          <div class="card dashboard-chart-card">
            <h3>Usuarios nuevos por mes</h3>
            <canvas id="usersByMonthChart"></canvas>
          </div>
          <div class="card dashboard-chart-card">
            <h3>Eventos por día</h3>
            <canvas id="dailyActivityChart"></canvas>
          </div>
        </div>

        <div class="card" style="margin-bottom:1rem;">
          <h3>Eventos recientes</h3>
          <div class="dashboard-table-wrapper">
            <table class="dashboard-table">
              <thead>
                <tr>
                  <th>Fecha</th>
                  <th>Tipo</th>
                  <th>Usuario</th>
                  <th>Receta</th>
                </tr>
              </thead>
              <tbody>
                <% if (recentEvents && recentEvents.length) { %>
                  <% recentEvents.forEach(function(event) { %>
                    <tr>
                      <td><%= new Date(event.fecha).toLocaleString('es-ES') %></td>
                      <td><%= event.tipo %></td>
                      <td><%= (event.usuario_id && (event.usuario_id.name || event.usuario_id.nombre)) || 'Anónimo' %></td>
                      <td><%= (event.receta_id && (event.receta_id.title || event.receta_id.titulo)) || 'N/A' %></td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="4">No hay eventos recientes para este período.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <%- include("partials/footer") %>
      </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
    <% 
      const __DASH_INIT = {
        totalUsers: (typeof totalUsers !== 'undefined' ? totalUsers : 0),
        totalRecipes: (typeof totalRecipes !== 'undefined' ? totalRecipes : 0),
        totalIngredients: (typeof totalIngredients !== 'undefined' ? totalIngredients : 0),
        totalEvents: (typeof totalEvents !== 'undefined' ? totalEvents : 0),
        eventsInRange: (typeof eventsInRange !== 'undefined' ? eventsInRange : 0),
        activeUsers: (typeof activeUsers !== 'undefined' ? activeUsers : 0),
        eventSummary: (typeof eventSummary !== 'undefined' ? eventSummary : {}),
        topRecipes: (typeof topRecipes !== 'undefined' ? topRecipes : []),
        topRecipesByLikes: (typeof topRecipesByLikes !== 'undefined' ? topRecipesByLikes : []),
        topUsers: (typeof topUsers !== 'undefined' ? topUsers : []),
        topIngredients: (typeof topIngredients !== 'undefined' ? topIngredients : []),
        regionViews: (typeof regionViews !== 'undefined' ? regionViews : []),
        recipesByUser: (typeof recipesByUser !== 'undefined' ? recipesByUser : []),
        monthlyLabels: (typeof monthlyLabels !== 'undefined' ? monthlyLabels : []),
        monthlyCounts: (typeof monthlyCounts !== 'undefined' ? monthlyCounts : []),
        weekdayLabels: (typeof weekdayLabels !== 'undefined' ? weekdayLabels : []),
        weekdayCounts: (typeof weekdayCounts !== 'undefined' ? weekdayCounts : []),
        recentEvents: (typeof recentEvents !== 'undefined' ? recentEvents : []),
        topSavedRecipes: (typeof topSavedRecipes !== 'undefined' ? topSavedRecipes : []),
        topCategories: (typeof topCategories !== 'undefined' ? topCategories : []),
        topCookbooks: (typeof topCookbooks !== 'undefined' ? topCookbooks : []),
        avgPrepTime: (typeof avgPrepTime !== 'undefined' ? avgPrepTime : null)
      };
    %>
    <script>
      window.__DASHBOARD_INIT = <%- JSON.stringify(__DASH_INIT) %>;
    </script>
    <script src="/js/admin-dashboard.js"></script>
    <script>
      (function() {
        if (typeof ChartDataLabels !== 'undefined') {
          Chart.register(ChartDataLabels);
        }

        const init = window.__DASHBOARD_INIT || {};
        const monthlyLabels = init.monthlyLabels || [];
        const monthlyCounts = init.monthlyCounts || [];
        const weekdayLabels = init.weekdayLabels || [];
        const weekdayCounts = init.weekdayCounts || [];

        function renderChart(canvasId, labels, data, label, borderColor) {
          const ctx = document.getElementById(canvasId);
          if (!ctx || typeof Chart === 'undefined') return;
          new Chart(ctx.getContext('2d'), {
            type: 'bar',
            data: {
              labels,
              datasets: [{
                label,
                data,
                backgroundColor: 'rgba(125, 63, 23, 0.18)',
                borderColor: borderColor,
                borderWidth: 1
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              scales: {
                y: {
                  beginAtZero: true,
                  ticks: { precision: 0 }
                }
              },
              plugins: {
                legend: { display: false }
              }
            }
          });
        }

        // Nueva función para graficar los Leaderboards (Gráficos horizontales)
        function renderHorizontalBarChart(canvasId, labels, data, labelText, color) {
          const ctx = document.getElementById(canvasId);
          if (!ctx || typeof Chart === 'undefined') return;
          
          if (!data || data.length === 0) {
            ctx.parentNode.innerHTML = '<p class="muted" style="font-size:0.85rem; padding-top: 1rem;">No hay datos suficientes.</p>';
            return;
          }

          // Convertimos el hex a rgba para el fondo de la barra
          let bgColor = color;
          if(color.startsWith('#')) {
            const r = parseInt(color.slice(1, 3), 16);
            const g = parseInt(color.slice(3, 5), 16);
            const b = parseInt(color.slice(5, 7), 16);
            bgColor = `rgba(${r}, ${g}, ${b}, 0.2)`;
          }

          new Chart(ctx.getContext('2d'), {
            type: 'bar',
            data: {
              labels: labels,
              datasets: [{
                label: labelText,
                data: data,
                backgroundColor: bgColor,
                borderColor: color,
                borderWidth: 1,
                borderRadius: 4
              }]
            },
            options: {
              indexAxis: 'y', // Fuerza la gráfica horizontal
              responsive: true,
              maintainAspectRatio: false,
              scales: {
                x: {
                  beginAtZero: true,
                  ticks: { precision: 0 }
                },
                y: {
                  ticks: {
                    autoSkip: false,
                    callback: function(value) {
                      const lbl = this.getLabelForValue(value);
                      return lbl.length > 22 ? lbl.substring(0, 22) + '...' : lbl;
                    }
                  }
                }
              },
              plugins: {
                legend: { display: false },
                tooltip: {
                  callbacks: {
                    title: function(context) { return context[0].label; }
                  }
                },
                datalabels: {
                  anchor: 'end',
                  align: 'right',
                  color: color,
                  font: { weight: 'bold', size: 11 },
                  formatter: Math.round
                }
              }
            }
          });
        }

        function renderInteractionChart(canvasId, labels, data, colors) {
          const ctx = document.getElementById(canvasId);
          if (!ctx || typeof Chart === 'undefined') return;
          new Chart(ctx.getContext('2d'), {
            type: 'doughnut',
            data: {
              labels,
              datasets: [{
                data,
                backgroundColor: colors,
                borderColor: '#fff',
                borderWidth: 2
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              cutout: '45%',
              plugins: {
                legend: {
                  position: 'bottom',
                  labels: { boxWidth: 12, padding: 12 }
                },
                tooltip: {
                  callbacks: {
                    label: function(context) {
                      const value = Number(context.parsed || 0);
                      const total = context.dataset.data.reduce((sum, v) => sum + Number(v || 0), 0) || 1;
                      const pct = Math.round((value / total) * 100);
                      return `${context.label}: ${value} (${pct}%)`;
                    }
                  }
                },
                datalabels: {
                  color: '#fff',
                  formatter: function(value, ctx) {
                    const total = ctx.dataset.data.reduce((sum, v) => sum + Number(v || 0), 0) || 1;
                    const pct = Math.round((Number(value) / total) * 100);
                    return pct > 5 ? `${value} (${pct}%)` : '';
                  },
                  anchor: 'center',
                  align: 'center',
                  font: { weight: '600', size: 12 }
                }
              }
            }
          });
        }

        renderChart('usersByMonthChart', monthlyLabels, monthlyCounts, 'Usuarios nuevos', '#b7652a');
        renderChart('dailyActivityChart', weekdayLabels, weekdayCounts, 'Eventos', '#7d3f17');

        const eventSummary = (window.__DASHBOARD_INIT && window.__DASHBOARD_INIT.eventSummary) || {};
        renderInteractionChart(
          'interactionChart',
          ['Visitas', 'Likes', 'Guardados', 'Búsquedas', 'Creaciones'],
          [
            Number(eventSummary.ver_receta || 0),
            Number(eventSummary.like || 0),
            Number(eventSummary.guardar_receta || 0),
            Number(eventSummary.buscar_receta || 0),
            Number(eventSummary.crear_receta || 0)
          ],
          ['#f6b26b', '#ea9999', '#93c47d', '#6fa8dc', '#b4a7d6']
        );

        // --- RENDERIZADO DE LOS LEADERBOARDS HORIZONTALES ---
        
        const _topRecipes = init.topRecipes || [];
        renderHorizontalBarChart('topRecipesChart', _topRecipes.map(i => i.title), _topRecipes.map(i => i.total), 'Visitas', '#b7652a');
        
        const _topLikes = init.topRecipesByLikes || [];
        renderHorizontalBarChart('topLikesChart', _topLikes.map(i => i.title), _topLikes.map(i => i.total), 'Likes', '#e67e22');
        
        const _topUsers = init.topUsers || [];
        renderHorizontalBarChart('topUsersChart', _topUsers.map(i => i.name), _topUsers.map(i => i.total), 'Interacciones', '#2980b9');
        
        const _topIngredients = init.topIngredients || [];
        renderHorizontalBarChart('topIngredientsChart', _topIngredients.map(i => i.name || 'Desconocido'), _topIngredients.map(i => i.total), 'Usos', '#27ae60');
        
        const _regionViews = init.regionViews || [];
        renderHorizontalBarChart('regionViewsChart', _regionViews.map(i => i.name || 'Sin región'), _regionViews.map(i => i.total), 'Visitas', '#8e44ad');
        
        const _recipesByUser = init.recipesByUser || [];
        renderHorizontalBarChart('recipesByUserChart', _recipesByUser.map(i => i.name), _recipesByUser.map(i => i.total), 'Recetas', '#16a085');
        
        const _topSaved = init.topSavedRecipes || [];
        renderHorizontalBarChart('topSavedChart', _topSaved.map(i => i.title || i.name), _topSaved.map(i => i.total), 'Guardados', '#f39c12');
        
        const _topCookbooks = init.topCookbooks || [];
        renderHorizontalBarChart(
          'topCookbooksChart', 
          _topCookbooks.map(i => i.title || i.name), 
          _topCookbooks.map(i => i.followersCount || i.followers || i.recipesCount || i.recipes || i.total || 0), 
          'Total', 
          '#c0392b'
        );

      })();
    </script>
  </body>
</html>
<style>
.chart-note {
  margin: 0.6rem 0 0 0;
  color: #5a452f;
  font-size: 0.9rem;
  line-height: 1.4;
}
.users-card {
  position: relative;
  overflow: visible;
}

.user-card span{
  color:black;
}

.users-hover-preview {
  position: absolute;
  top: 50%;
  left: 105%;
  width: 260px;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-50%) translateX(-12px) scale(.96);
  transition: opacity .25s ease, transform .25s ease, visibility .25s ease;
  z-index: 50;
  padding: 1rem;
  border-radius: 22px;
  background: linear-gradient(135deg, rgba(255,255,255,.92), rgba(255,255,255,.82));
  backdrop-filter: blur(18px);
  border: 1px solid rgba(255,255,255,.25);
  box-shadow: 0 20px 50px rgba(0,0,0,.18), 0 0 40px rgba(183,101,42,.12);
}

.users-card:hover .users-hover-preview {
  opacity: 1;
  visibility: visible;
  transform: translateY(-50%) translateX(0) scale(1);
}

.hover-preview-header {
  font-size: .82rem;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--text-soft);
  margin-bottom: 1rem;
}

.hover-users-list {
  display: flex;
  flex-direction: column;
  gap: .75rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.hover-user-item {
  display: flex;
  align-items: center;
  gap: .8rem;
  padding: .7rem;
  border-radius: 14px;
  transition: background .2s ease, transform .2s ease;
}

.hover-user-item:hover {
  background: rgba(183,101,42,.08);
  transform: translateX(4px);
}

.hover-user-avatar {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-weight: 700;
  color: white;
  background: linear-gradient(135deg, #7d3f17, #b7652a);
  box-shadow: 0 8px 20px rgba(183,101,42,.25);
}

.hover-user-info {
  display: flex;
  flex-direction: column;
}

.hover-user-info strong {
  font-size: .95rem;
}

.hover-user-info small {
  color: var(--text-soft);
  font-size: .8rem;
}
</style>