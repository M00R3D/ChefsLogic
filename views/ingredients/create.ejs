<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="app-shell">
      <%- include("../partials/navbar", { activeTab }) %>

      <main class="main-content">
        <%- include("../partials/header", { pageTitle: isEditMode ? "Editar ingrediente" : "Nuevo ingrediente" }) %>

        <% if (errorMessage) { %>
          <div class="alert alert-error"><%= errorMessage %></div>
        <% } %>

        <% if (!(typeof currentUser !== 'undefined' && currentUser && String(currentUser.role || '').toLowerCase() === 'admin')) { %>
          <div class="alert alert-warning"><%= isEditMode ? 'Este ingrediente está ligado a tu cuenta y puedes actualizarlo o eliminarlo cuando lo necesites.' : 'El ingrediente quedará ligado a tu cuenta para que puedas editarlo o eliminarlo más adelante.' %></div>
        <% } %>

        <section class="card">
          <form class="form-grid" id="ingredient-form" action="<%= formAction || '/ingredients' %>" method="POST">

            <!-- NOMBRE + CATEGORIA -->
            <div class="form-grid cols-2">
              <label>
                Nombre del ingrediente
                <input id="ing-name-input" name="name" type="text" required
                       value="<%= ingredient ? (ingredient.name || ingredient.nombre || '') : '' %>"
                       data-original-name="<%= ingredient ? (ingredient.name || ingredient.nombre || '') : '' %>"
                       placeholder="Ej. Chile ancho, Epazote, Manteca..."
                       autocomplete="off" />
                <span class="form-help" id="ing-name-feedback"></span>
              </label>

              <label>
                Unidad por defecto
                <select name="defaultUnit">
                  <% const selectedUnit = ingredient ? (ingredient.defaultUnit || ingredient.unidad || 'g') : 'g'; %>
                  <option value="g" <%= selectedUnit === 'g' ? 'selected' : '' %>>g — gramos</option>
                  <option value="kg" <%= selectedUnit === 'kg' ? 'selected' : '' %>>kg — kilogramos</option>
                  <option value="ml" <%= selectedUnit === 'ml' ? 'selected' : '' %>>ml — mililitros</option>
                  <option value="l" <%= selectedUnit === 'l' ? 'selected' : '' %>>l — litros</option>
                  <option value="pieza" <%= selectedUnit === 'pieza' ? 'selected' : '' %>>pieza</option>
                  <option value="cdita" <%= selectedUnit === 'cdita' ? 'selected' : '' %>>cdita — cucharadita</option>
                  <option value="cda" <%= selectedUnit === 'cda' ? 'selected' : '' %>>cda — cucharada</option>
                  <option value="taza" <%= selectedUnit === 'taza' ? 'selected' : '' %>>taza</option>
                  <option value="manojo" <%= selectedUnit === 'manojo' ? 'selected' : '' %>>manojo</option>
                  <option value="ramita" <%= selectedUnit === 'ramita' ? 'selected' : '' %>>ramita</option>
                  <option value="lata" <%= selectedUnit === 'lata' ? 'selected' : '' %>>lata</option>
                  <option value="botella" <%= selectedUnit === 'botella' ? 'selected' : '' %>>botella</option>
                  <option value="sobre" <%= selectedUnit === 'sobre' ? 'selected' : '' %>>sobre</option>
                  <option value="diente" <%= selectedUnit === 'diente' ? 'selected' : '' %>>diente</option>
                </select>
              </label>
            </div>

            <!-- CATEGORY SELECTOR (visual cards) -->
            <div class="form-group">
              <label class="form-label-text">Categoría</label>
              <input type="hidden" name="category" id="category-hidden" value="<%= ingredient ? (ingredient.category || ingredient.categoria || 'otro') : 'otro' %>" />
              <div class="ing-cat-selector" id="ing-cat-selector">
                <button type="button" class="ing-cat-option" data-cat="verdura"   style="--cc:#2e7d32;--cb:#e8f5e9">🥦 Verdura</button>
                <button type="button" class="ing-cat-option" data-cat="fruta"     style="--cc:#c62828;--cb:#ffebee">🍎 Fruta</button>
                <button type="button" class="ing-cat-option" data-cat="proteina"  style="--cc:#b71c1c;--cb:#fff3e0">🥩 Proteína</button>
                <button type="button" class="ing-cat-option" data-cat="grano"     style="--cc:#6d4c41;--cb:#efebe9">🌾 Grano</button>
                <button type="button" class="ing-cat-option" data-cat="especia"   style="--cc:#e65100;--cb:#fff8e1">✨ Especia</button>
                <button type="button" class="ing-cat-option" data-cat="lacteo"    style="--cc:#1565c0;--cb:#e3f2fd">🧀 Lácteo</button>
                <button type="button" class="ing-cat-option" data-cat="aceite"    style="--cc:#5c4a1e;--cb:#fef9e7">🫙 Aceite</button>
                <button type="button" class="ing-cat-option" data-cat="condimento" style="--cc:#7b341e;--cb:#fdf2e8">🥫 Condimento</button>
                <button type="button" class="ing-cat-option" data-cat="chile"     style="--cc:#c0392b;--cb:#fdedec">🌶️ Chile</button>
                <button type="button" class="ing-cat-option" data-cat="salsa"     style="--cc:#e74c3c;--cb:#fef5f5">🍅 Salsa</button>
                <button type="button" class="ing-cat-option" data-cat="bebida"    style="--cc:#2980b9;--cb:#eaf4fc">🫗 Bebida</button>
                <button type="button" class="ing-cat-option" data-cat="conserva"  style="--cc:#7d6608;--cb:#fdfce6">🥃 Conserva</button>
                <button type="button" class="ing-cat-option" data-cat="hongo"     style="--cc:#6e4b7b;--cb:#f4edf7">🍄 Hongo</button>
                <button type="button" class="ing-cat-option is-selected" data-cat="otro" style="--cc:#546e7a;--cb:#f5f5f5">🧺 Otro</button>
              </div>
            </div>

            <!-- ETIQUETAS (tag builder con sugerencias de ingredientes) -->
            <div class="form-group">
              <label class="form-label-text">Etiquetas</label>
              <input type="hidden" name="tags" id="ing-tags-hidden" value="<%= ingredient && Array.isArray(ingredient.tags) ? ingredient.tags.join(',') : '' %>" />
              <div class="tag-builder" id="ing-tag-builder">
                <div class="tag-list" id="ing-tag-list"></div>
                <div class="tag-entry-row">
                  <input class="tag-entry-input" id="ing-tag-input" type="text"
                         placeholder="fresco, organico, picante…" autocomplete="off" />
                  <button class="tag-add-btn" type="button" id="ing-tag-add">+</button>
                </div>
                <div class="tag-suggestions" id="ing-tag-suggestions"></div>
              </div>
            </div>

            <!-- ESTACIONALIDAD -->
            <div class="form-group">
              <label class="form-label-text">Estacionalidad *</label>
              <input type="hidden" name="seasonality" id="seasonality-hidden" value="<%= ingredient && Array.isArray(ingredient.seasonality) ? ingredient.seasonality.join(', ') : '' %>" />
              <div class="ing-month-grid" id="ing-month-grid">
                <button type="button" class="ing-month-btn" data-month="enero">Ene</button>
                <button type="button" class="ing-month-btn" data-month="febrero">Feb</button>
                <button type="button" class="ing-month-btn" data-month="marzo">Mar</button>
                <button type="button" class="ing-month-btn" data-month="abril">Abr</button>
                <button type="button" class="ing-month-btn" data-month="mayo">May</button>
                <button type="button" class="ing-month-btn" data-month="junio">Jun</button>
                <button type="button" class="ing-month-btn" data-month="julio">Jul</button>
                <button type="button" class="ing-month-btn" data-month="agosto">Ago</button>
                <button type="button" class="ing-month-btn" data-month="septiembre">Sep</button>
                <button type="button" class="ing-month-btn" data-month="octubre">Oct</button>
                <button type="button" class="ing-month-btn" data-month="noviembre">Nov</button>
                <button type="button" class="ing-month-btn" data-month="diciembre">Dic</button>
              </div>
              <span class="form-help" id="ing-seasonality-feedback">Selecciona al menos un mes.</span>
            </div>

            <!-- ACCESIBILIDAD -->
            <label>
              Accesibilidad / precio
              <select name="accesibilidad">
                <% const selectedAccessibility = ingredient ? (ingredient.accesibilidad || 'medio') : 'medio'; %>
                <option value="economico" <%= selectedAccessibility === 'economico' ? 'selected' : '' %>>💚 Económico</option>
                <option value="medio" <%= selectedAccessibility === 'medio' ? 'selected' : '' %>>💛 Precio medio</option>
                <option value="premium" <%= selectedAccessibility === 'premium' ? 'selected' : '' %>>🔴 Premium</option>
              </select>
            </label>

            <!-- INFORMACIÓN NUTRICIONAL -->
            <fieldset class="ing-nutrition-fieldset">
              <legend>Información nutricional <span class="muted">(por 100 g / unidad)</span></legend>
              <div class="form-grid cols-4">
                <label>
                  🔥 Calorías
                  <input name="calories" type="number" min="0" step="0.01" placeholder="0" value="<%= ingredient && ingredient.nutritionalInfo ? ingredient.nutritionalInfo.calories || '' : '' %>" />
                </label>
                <label>
                  💪 Proteína (g)
                  <input name="protein" type="number" min="0" step="0.01" placeholder="0" value="<%= ingredient && ingredient.nutritionalInfo ? ingredient.nutritionalInfo.protein || '' : '' %>" />
                </label>
                <label>
                  🌾 Carbohidratos (g)
                  <input name="carbs" type="number" min="0" step="0.01" placeholder="0" value="<%= ingredient && ingredient.nutritionalInfo ? ingredient.nutritionalInfo.carbs || '' : '' %>" />
                </label>
                <label>
                  🧈 Grasas (g)
                  <input name="fat" type="number" min="0" step="0.01" placeholder="0" value="<%= ingredient && ingredient.nutritionalInfo ? ingredient.nutritionalInfo.fat || '' : '' %>" />
                </label>
              </div>
            </fieldset>

            <div class="actions">
              <button class="btn btn-primary" type="submit"><%= submitLabel || 'Guardar ingrediente' %></button>
              <a class="btn btn-soft" href="<%= ingredient ? '/ingredients/' + ingredient._id : '/ingredients' %>">Cancelar</a>
            </div>
          </form>
        </section>

        <%- include("../partials/footer") %>
      </main>
    </div>

    <!-- Sugerencias de etiquetas para ingredientes -->
    <script id="tag-suggestions-data" type="application/json">
    ["fresco","seco","local","organico","temporada","importado","procesado","natural",
     "fermentado","ahumado","encurtido","congelado","enlatado","artesanal","premium",
     "economico","picante","dulce","amargo","acido","salado","umami","crudo","cocido",
     "tostado","molido","entero","maduro","verde","deshidratado","en_polvo","en_pasta",
     "sin_gluten","vegano","sin_lactosa","integral","refinado","kasher","halal","sin_sal"]
    </script>
    <script src="/js/forms.js"></script>
    <script>
      // Category selector
      (function() {
        const selector = document.getElementById('ing-cat-selector');
        const hidden   = document.getElementById('category-hidden');
        if (!selector || !hidden) return;
        selector.querySelectorAll('.ing-cat-option').forEach(function(btn) {
          btn.classList.toggle('is-selected', btn.dataset.cat === hidden.value);
        });
        selector.querySelectorAll('.ing-cat-option').forEach(function(btn) {
          btn.addEventListener('click', function() {
            selector.querySelectorAll('.ing-cat-option').forEach(function(b) { b.classList.remove('is-selected'); });
            btn.classList.add('is-selected');
            hidden.value = btn.dataset.cat;
          });
        });
      })();

      // Ingredient tag builder (uses buildIngredientTagBuilder from forms.js)
      (function() {
        // Read suggestions from embedded JSON
        var suggestionsEl = document.getElementById('tag-suggestions-data');
        var suggestions = [];
        try { suggestions = JSON.parse(suggestionsEl ? suggestionsEl.textContent : '[]'); } catch(e) {}

        var hidden   = document.getElementById('ing-tags-hidden');
        var list     = document.getElementById('ing-tag-list');
        var input    = document.getElementById('ing-tag-input');
        var addBtn   = document.getElementById('ing-tag-add');
        var sugsWrap = document.getElementById('ing-tag-suggestions');
        if (!hidden || !list || !input || !addBtn) return;

        var tags = String(hidden.value || '')
          .split(',')
          .map(function(tag) { return tag.trim().toLowerCase(); })
          .filter(Boolean);

        function renderTags() {
          list.innerHTML = '';
          tags.forEach(function(t, i) {
            var chip = document.createElement('span');
            chip.className = 'tag-chip';
            chip.innerHTML = '<span>' + t + '</span><button type="button" class="tag-chip-x" data-i="' + i + '">×</button>';
            list.appendChild(chip);
          });
          hidden.value = tags.join(',');
        }

        function addTag(val) {
          var t = val.trim().toLowerCase().replace(/\s+/g, '_');
          if (!t || tags.includes(t)) return;
          tags.push(t);
          renderTags();
          input.value = '';
          renderSugs('');
        }

        function renderSugs(q) {
          sugsWrap.innerHTML = '';
          if (!q && !document.activeElement === input) return;
          var matches = suggestions.filter(function(s) {
            return s.includes(q.toLowerCase()) && !tags.includes(s);
          }).slice(0, 10);
          matches.forEach(function(s) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'tag-suggestion-btn';
            btn.textContent = s;
            btn.addEventListener('click', function() { addTag(s); input.focus(); });
            sugsWrap.appendChild(btn);
          });
          sugsWrap.style.display = matches.length ? 'flex' : 'none';
        }

        addBtn.addEventListener('click', function() { addTag(input.value); });
        input.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') { e.preventDefault(); addTag(input.value); }
          if (e.key === ',')     { e.preventDefault(); addTag(input.value); }
        });
        input.addEventListener('input', function() { renderSugs(input.value); });
        input.addEventListener('focus', function() { renderSugs(input.value); });

        list.addEventListener('click', function(e) {
          var x = e.target.closest('.tag-chip-x');
          if (x) { tags.splice(parseInt(x.dataset.i, 10), 1); renderTags(); }
        });

        // Show all suggestions on focus when empty
        input.addEventListener('focus', function() {
          if (!input.value) renderSugs('');
        });

        renderTags();
        renderSugs('');
      })();
    </script>
  </body>
</html>
