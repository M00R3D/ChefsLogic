<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <style>
      :root {
        --bg: #fff8ef;
        --card: #fff;
        --primary: #0f4c3a;
        --accent: #e76f51;
        --text: #1f2937;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background: radial-gradient(circle at top left, #ffe8cc, var(--bg));
        color: var(--text);
      }

      .container {
        max-width: 920px;
        margin: 0 auto;
        padding: 2rem 1rem;
      }

      .hero {
        background: var(--card);
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      }

      h1 {
        margin-top: 0;
        color: var(--primary);
      }

      .chip {
        display: inline-block;
        padding: 0.4rem 0.7rem;
        border-radius: 999px;
        background: #f4f4f5;
        margin-right: 0.4rem;
        margin-bottom: 0.4rem;
      }

      #status {
        margin-top: 1rem;
        padding: 0.75rem 1rem;
        border-left: 4px solid var(--accent);
        background: #fff7f3;
      }
    </style>
  </head>
  <body>
    <main class="container">
      <section class="hero">
        <h1><%= appName %></h1>
        <p>
          Base SSR lista con Express + EJS + MongoDB para recetas mexicanas,
          dashboards culinarios y analitica.
        </p>

        <div>
          <span class="chip">Node.js</span>
          <span class="chip">Express</span>
          <span class="chip">EJS SSR</span>
          <span class="chip">MongoDB + Mongoose</span>
          <span class="chip">Vanilla JS + fetch()</span>
        </div>

        <div id="status">Verificando estado de la API...</div>
      </section>
    </main>

    <script src="/js/main.js"></script>
  </body>
</html>
