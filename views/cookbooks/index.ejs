<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="app-shell">
      <%- include("../partials/navbar", { activeTab }) %>

      <main class="main-content">
        <%- include("../partials/header", { pageTitle: "Recetarios" }) %>

        <%
          const THEME_META = {
            mexicana:      { emoji: '🇲🇽', color: '#c0392b', bg: '#fdedec', label: 'Mexicana' },
            postres:       { emoji: '🍮', color: '#d35400', bg: '#fef5e7', label: 'Postres' },
            bebidas:       { emoji: '🍹', color: '#2980b9', bg: '#eaf4fc', label: 'Bebidas' },
            vegano:        { emoji: '🌱', color: '#27ae60', bg: '#e9f7ef', label: 'Vegano' },
            mariscos:      { emoji: '🦐', color: '#1a6e8e', bg: '#e8f6f9', label: 'Mariscos' },
            antojitos:     { emoji: '🫔', color: '#e67e22', bg: '#fdf2e9', label: 'Antojitos' },
            sopas:         { emoji: '🍲', color: '#8e44ad', bg: '#f5eef8', label: 'Sopas' },
            desayunos:     { emoji: '🍳', color: '#f39c12', bg: '#fef9e7', label: 'Desayunos' },
            carnes:        { emoji: '🥩', color: '#922b21', bg: '#fdedec', label: 'Carnes' },
            internacional: { emoji: '🌍', color: '#2c3e50', bg: '#f2f3f4', label: 'Internacional' },
            otro:          { emoji: '📖', color: '#546e7a', bg: '#f5f5f5', label: 'Otro' }
          };
          function getTheme(t) { return THEME_META[String(t||'otro').toLowerCase()] || THEME_META.otro; }
          function cookbookSymbol(cb) {
            const manual = String(cb.coverEmoji || '').trim();
            if (manual) return manual;
            const text = `${cb.title || cb.nombre || ''} ${(cb.tags || []).join(' ')}`.toLowerCase();
            if (/taco|taquer|pastor|barbacoa|cochinita|quesabirria/.test(text)) return '🌮';
            if (/sopa|caldo|consome|menudo|pozole/.test(text)) return '🍲';
            if (/postre|dulce|pastel|flan|gelatina|pay|pan/.test(text)) return '🍮';
            if (/desayuno|huevo|hotcake|chilaquil|avena/.test(text)) return '🍳';
            if (/bebida|cafe|atole|chocolate|agua|coctel|licuado/.test(text)) return '🍹';
            if (/marisco|camaron|atun|pescado|ceviche/.test(text)) return '🦐';
            if (/ensalada|veg|verdura|tofu|plant|fit/.test(text)) return '🌱';
            if (/carne|res|cerdo|pollo|asado|costilla/.test(text)) return '🥩';
            if (/antojito|tamal|gordita|sopes|tlayuda|flauta/.test(text)) return '🫔';
            return getTheme(cb.theme).emoji;
          }
          function ownerName(cb) {
            const owner = cb.owner || cb.usuario_id;
            if (owner && typeof owner === 'object') return owner.name || owner.nombre || 'Usuario';
            return 'Usuario';
          }
          function buildCbQuery(overrides) {
            const base = { q: search, theme: themeFilter, page: page };
            const merged = Object.assign({}, base, overrides);
            const params = Object.entries(merged).filter(([,v]) => v && v !== '' && v !== 'all' && v !== 1)
              .map(([k,v]) => k + '=' + encodeURIComponent(v));
            return params.length ? '/cookbooks?' + params.join('&') : '/cookbooks';
          }
        %>

        <% if (errorMessage) { %>
          <div class="alert alert-error"><%= errorMessage %></div>
        <% } %>

        <!-- TOPBAR -->
        <section class="ing-index-topbar">
          <form class="ing-search-form" action="/cookbooks" method="GET">
            <% if (themeFilter && themeFilter !== 'all') { %>
              <input type="hidden" name="theme" value="<%= themeFilter %>" />
            <% } %>
            <input class="ing-index-search" type="text" name="q" value="<%= search %>" placeholder="Buscar recetario..." autocomplete="off" />
            <button class="btn btn-soft btn-sm" type="submit">Buscar</button>
            <% if (search || themeFilter) { %>
              <a class="btn btn-ghost btn-sm" href="/cookbooks">Limpiar</a>
            <% } %>
          </form>
          <a class="btn btn-primary" href="/cookbooks/create">+ Nuevo recetario</a>
        </section>

        <!-- THEME FILTER PILLS -->
        <section class="ing-cat-filter-row">
          <a class="ing-filter-pill <%= (!themeFilter || themeFilter === 'all') ? 'is-active' : '' %>"
             href="/cookbooks<%= search ? '?q=' + encodeURIComponent(search) : '' %>">
            Todos <span class="ing-filter-count"><%= total %></span>
          </a>
          <% allThemes.forEach((theme) => { %>
            <% const tm = getTheme(theme); %>
            <% const cnt = themeCountMap[theme] || 0; %>
            <% if (cnt > 0 || themeFilter === theme) { %>
              <a class="ing-filter-pill <%= themeFilter === theme ? 'is-active' : '' %>"
                 style="--pill-color:<%= tm.color %>;--pill-bg:<%= tm.bg %>"
                 href="<%= buildCbQuery({theme: theme, page: 1}) %>">
                <%= tm.emoji %> <%= tm.label %> <span class="ing-filter-count"><%= cnt %></span>
              </a>
            <% } %>
          <% }); %>
        </section>

        <!-- META -->
        <div class="ing-results-meta">
          <span class="muted"><%= total %> recetario<%= total !== 1 ? 's' : '' %>
            <% if (search) { %> · "<%= search %>"<% } %>
            <% if (themeFilter && themeFilter !== 'all') { %> · <%= getTheme(themeFilter).label %><% } %>
            · página <%= page %> de <%= totalPages %>
          </span>
        </div>

        <!-- COOKBOOK CARDS -->
        <section class="grid cols-3 cb-cards-grid">
          <% if (!cookbooks || cookbooks.length === 0) { %>
            <article class="card" style="grid-column:1/-1;text-align:center;">
              <p class="muted">No se encontraron recetarios.</p>
              <a class="btn btn-soft btn-sm" href="/cookbooks">Ver todos</a>
            </article>
          <% } %>

          <% cookbooks.forEach((cb, idx) => { %>
            <%
              const cbThemeMeta = getTheme(cb.theme || 'otro');
              const cbImg = String(cb.coverImage || '').trim();
              const cbCanImg = /^(https?:\/\/|\/|data:image\/)/.test(cbImg);
              const cbSafeHex = /^#[0-9a-fA-F]{3,6}$/.test(String(cb.accentColor||'')) ? cb.accentColor : '';
              const cbAccent = cbSafeHex || cbThemeMeta.color;
              const cbEmoji = cookbookSymbol(cb);
              const cbRecipeCount = (cb.recipes || cb.recetas || []).length;
              const currentUserId = (typeof currentUser !== 'undefined' && currentUser) ? String(currentUser._id) : '';
              const ownerId = String((cb.owner && cb.owner._id) || cb.owner || (cb.usuario_id && cb.usuario_id._id) || cb.usuario_id || '');
              const isAdmin = (typeof currentUser !== 'undefined' && currentUser) && String(currentUser.role || '').toLowerCase() === 'admin';
              const canManage = Boolean(currentUserId && ownerId && currentUserId === ownerId) || Boolean(isAdmin);
              const ownerLabel = ownerName(cb);
              const previewRecipes = Array.isArray(cb.recipes) ? cb.recipes.slice(0, 4) : [];
              const previewImageCandidates = (Array.isArray(cb.recipes) ? cb.recipes : [])
                .map((recipe) => String((recipe && (recipe.imageUrl || recipe.imagen_principal)) || '').trim())
                .filter((img) => /^(https?:\/\/|\/|data:image\/)/i.test(img));
              const encodedPreviewImages = encodeURIComponent(JSON.stringify(previewImageCandidates));
            %>
            <article class="cb-card cb-book-card reveal" data-reveal-index="<%= idx %>" data-cookbook-card="<%= cb._id %>" role="button" tabindex="0" style="--cb-accent:<%= cbAccent %>">
              <div class="cb-book-spine"></div>
              <div class="cb-book-pages"></div>
              <div class="cb-card-cover">
                <div
                  class="cb-card-cover-carousel"
                  data-cb-preview-carousel
                  data-carousel-images="<%= encodedPreviewImages %>"
                  data-cover-fallback="<%= (cbImg && cbCanImg) ? cbImg : '' %>">
                  <div class="cb-card-cover-slide is-active"></div>
                  <div class="cb-card-cover-slide"></div>
                </div>
                <div class="cb-card-cover-overlay"></div>
                <span class="cb-card-emoji"><%= cbEmoji %></span>
                <div class="cb-card-cover-badges">
                  <span class="cb-theme-badge" style="--pill-color:<%= cbThemeMeta.color %>;--pill-bg:<%= cbThemeMeta.bg %>">
                    <%= cbThemeMeta.emoji %> <%= cbThemeMeta.label %>
                  </span>
                  <span class="cb-public-badge <%= (cb.isPublic || cb.publico) ? 'is-public' : 'is-private' %>">
                    <%= (cb.isPublic || cb.publico) ? '🌐 Público' : '🔒 Privado' %>
                  </span>
                </div>
                <% if (canManage) { %>
                  <div class="cb-card-admin-actions">
                    <a class="btn btn-soft btn-sm" href="/cookbooks/<%= cb._id %>/edit">Editar</a>
                    <form action="/cookbooks/<%= cb._id %>/delete" method="POST" style="margin:0;">
                      <button class="btn btn-danger btn-sm" type="button" data-delete-cookbook="<%= cb._id %>" data-form-selector="form[action='/cookbooks/<%= cb._id %>/delete']">Eliminar</button>
                    </form>
                  </div>
                <% } %>
              </div>
              <div class="cb-card-body">
                <h3 class="cb-card-title"><%= cb.title || cb.nombre || 'Sin título' %></h3>
                <p class="cb-credit">Creado por <strong><%= ownerLabel %></strong></p>
                <div class="cb-card-footer">
                  <span class="muted">📋 <%= cbRecipeCount %> receta<%= cbRecipeCount !== 1 ? 's' : '' %></span>
                </div>
                <p class="muted" style="margin-top:.4rem;font-size:.78rem;">Haz clic en la tarjeta para abrir el libro.</p>
              </div>
              <div class="cb-hover-detail" aria-hidden="true">
                <h4 class="cb-hover-title">Vista rápida</h4>
                <% if (cb.description || cb.descripcion) { %>
                  <p class="cb-hover-desc"><%= String(cb.description || cb.descripcion || '').slice(0, 180) %><%= (cb.description || cb.descripcion || '').length > 180 ? '…' : '' %></p>
                <% } else { %>
                  <p class="cb-hover-desc">Este recetario aún no tiene descripción.</p>
                <% } %>
                <p class="cb-credit">Autor: <strong><%= ownerLabel %></strong></p>
                <% if (previewRecipes.length) { %>
                  <div class="cb-hover-recipes">
                    <% previewRecipes.forEach((recipe) => { %>
                      <span class="chip"><%= recipe.title || 'Receta' %></span>
                    <% }); %>
                  </div>
                <% } %>
              </div>
            </article>
          <% }); %>
        </section>

        <section id="cookbook-book-modal" class="cookbook-book-modal" aria-hidden="true">
          <div class="cookbook-book-backdrop" data-cookbook-close></div>
          <div class="cookbook-book-dialog" role="dialog" aria-modal="true" aria-labelledby="book-modal-title">
            <button class="cookbook-book-close" type="button" aria-label="Cerrar" data-cookbook-close>✕</button>
            <header class="cookbook-book-header">
              <p class="cookbook-book-kicker" id="book-modal-author">Creado por Usuario</p>
              <h3 id="book-modal-title">Recetario</h3>
              <p class="cookbook-book-summary" id="book-modal-summary">Detalle del recetario.</p>
            </header>

            <div class="cookbook-book-shell" id="cookbook-book-shell">
              <article class="cookbook-page cookbook-page-left" id="book-left-page"></article>
              <article class="cookbook-page cookbook-page-right" id="book-right-page"></article>
            </div>

            <footer class="cookbook-book-footer">
              <button class="btn btn-soft btn-sm" type="button" id="book-prev-page">⟵ Hoja anterior</button>
              <span class="cookbook-book-page-indicator" id="book-page-indicator">Hoja 1</span>
              <button class="btn btn-soft btn-sm" type="button" id="book-next-page">Hoja siguiente ⟶</button>
            </footer>
          </div>
        </section>

        <!-- PAGINATION -->
        <% if (totalPages > 1) { %>
          <nav class="ing-pagination">
            <% if (page > 1) { %>
              <a class="btn btn-soft btn-sm" href="<%= buildCbQuery({page: page - 1}) %>">← Anterior</a>
            <% } else { %>
              <span class="btn btn-soft btn-sm" style="opacity:0.4;cursor:default;">← Anterior</span>
            <% } %>
            <div class="ing-page-pills">
              <% const rs = Math.max(1, page - 2); const re = Math.min(totalPages, page + 2); %>
              <% if (rs > 1) { %><a class="ing-page-pill" href="<%= buildCbQuery({page:1}) %>">1</a><% if (rs > 2) { %><span class="ing-page-pill muted">…</span><% } %><% } %>
              <% for (let p = rs; p <= re; p++) { %>
                <a class="ing-page-pill <%= p === page ? 'is-active' : '' %>" href="<%= buildCbQuery({page:p}) %>"><%= p %></a>
              <% } %>
              <% if (re < totalPages) { %><% if (re < totalPages - 1) { %><span class="ing-page-pill muted">…</span><% } %><a class="ing-page-pill" href="<%= buildCbQuery({page:totalPages}) %>"><%= totalPages %></a><% } %>
            </div>
            <% if (page < totalPages) { %>
              <a class="btn btn-soft btn-sm" href="<%= buildCbQuery({page: page + 1}) %>">Siguiente →</a>
            <% } else { %>
              <span class="btn btn-soft btn-sm" style="opacity:0.4;cursor:default;">Siguiente →</span>
            <% } %>
          </nav>
        <% } %>

        <%- include("../partials/footer") %>
      </main>
    </div>

    <script id="cookbooks-book-data" type="application/json"><%- JSON.stringify((cookbooks || []).map((cb) => {
      const owner = cb.owner || cb.usuario_id || null;
      const ownerName = owner && typeof owner === 'object' ? (owner.name || owner.nombre || 'Usuario') : 'Usuario';
      const recipes = Array.isArray(cb.recipes) ? cb.recipes : [];
      return {
        _id: String(cb._id),
        title: cb.title || cb.nombre || 'Sin título',
        description: cb.description || cb.descripcion || '',
        ownerName,
        theme: cb.theme || 'otro',
        coverEmoji: cb.coverEmoji || '',
        coverImage: cb.coverImage || '',
        accentColor: cb.accentColor || '',
        recipes: recipes.map((recipe) => ({
          _id: String(recipe._id || ''),
          title: recipe.title || 'Receta',
          slug: recipe.slug || '',
          summary: recipe.summary || '',
          imageUrl: recipe.imageUrl || recipe.imagen_principal || ''
        }))
      };
    })) %></script>
    <script src="/js/recipes.js"></script>
  </body>
</html>
