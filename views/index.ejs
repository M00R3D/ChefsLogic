<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="app-shell">
      <%- include("partials/navbar", { activeTab }) %>

      <main class="main-content">
        <%- include("partials/header", { pageTitle: appName }) %>

        <section class="card">
          <h3>Plataforma culinaria mexicana</h3>
          <p class="muted">
            Base SSR profesional con arquitectura MVC para recetas, dashboards culinarios, recetarios e interacciones sociales.
          </p>

          <div class="actions">
            <span class="chip">Node.js</span>
            <span class="chip">Express</span>
            <span class="chip">EJS SSR</span>
            <span class="chip">MongoDB + Mongoose</span>
            <span class="chip">Vanilla JS + fetch()</span>
          </div>

          <div class="hero-kpi">
            <article class="kpi">
              <span class="muted">Modulos principales</span>
              <strong id="kpi-recipes"><%= typeof dashboardStats !== "undefined" ? dashboardStats.recipes : 0 %></strong>
              <span class="muted">Recetas</span>
            </article>
            <article class="kpi">
              <span class="muted">Gestion de catalogo</span>
              <strong id="kpi-ingredients"><%= typeof dashboardStats !== "undefined" ? dashboardStats.ingredients : 0 %></strong>
              <span class="muted">Ingredientes</span>
            </article>
            <article class="kpi">
              <span class="muted">Curacion social</span>
              <strong id="kpi-cookbooks"><%= typeof dashboardStats !== "undefined" ? dashboardStats.cookbooks : 0 %></strong>
              <span class="muted">Recetarios</span>
            </article>
          </div>

          <p class="muted" id="db-source" style="margin-top: 0.7rem;">
            Fuente de datos: MongoDB (<%= typeof dashboardStats !== "undefined" ? "chefslogic" : "no disponible" %>)
          </p>

          <div id="status" class="card" style="margin-top: 1rem;"><%= statusMessage %></div>
        </section>

        <%- include("partials/footer") %>
      </main>
    </div>

    <script src="/js/main.js"></script>
  </body>
</html>
