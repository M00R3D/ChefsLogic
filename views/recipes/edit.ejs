<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="app-shell">
      <%- include("../partials/navbar", { activeTab }) %>

      <main class="main-content">
        <%- include("../partials/header", { pageTitle: "Editar Receta" }) %>

        <% if (errorMessage || !recipe) { %>
          <section class="card">
            <p class="muted"><%= errorMessage || "No se pudo cargar la receta." %></p>
            <a class="btn btn-soft" href="/recipes">Volver</a>
          </section>
        <% } %>

        <% if (recipe) { %>
          <section class="create-steps card" style="margin-bottom:1rem;">
            <div class="step-pill is-active"><span>1</span> Básicos</div>
            <div class="step-line"></div>
            <div class="step-pill"><span>2</span> Ingredientes</div>
            <div class="step-line"></div>
            <div class="step-pill"><span>3</span> Instrucciones</div>
          </section>

          <section class="grid cols-2">
            <article class="card reveal">
              <form id="recipe-form" class="form-grid" action="/recipes/<%= recipe._id %>" method="POST">
                <div class="form-grid cols-2">
                  <label>
                    Título
                    <input type="text" name="title" value="<%= recipe.title %>" required minlength="3" maxlength="140" placeholder="Ej. Mole negro tradicional" />
                  </label>
                  <label>
                    Slug:
                    <input type="hidden" name="slug" id="slug-hidden" value="<%= recipe.slug %>" />
                    <div class="form-help" id="slug-preview" style="font-weight:600;"><%= recipe.slug || "-" %></div>
                    <span class="form-help" id="slug-feedback"></span>
                  </label>
                </div>

                <label>
                  Resumen
                  <textarea name="summary" placeholder="Cuenta el origen o historia de tu receta"><%= recipe.summary || "" %></textarea>
                </label>

                <div class="image-upload-block">
                  <span class="form-label">Imagen principal</span>
                  <div class="image-drop-zone" id="image-drop-zone">
                    <input type="file" id="image-file-input" accept="image/jpeg,image/png,image/webp,image/gif" style="display:none" />
                    <div class="drop-zone-inner" id="drop-zone-inner" style="<%= recipe.imageUrl ? 'display:none;' : '' %>">
                      <span class="drop-icon">📷</span>
                      <span class="drop-text">Arrastra aquí o <span class="drop-link" id="drop-link">selecciona archivo</span></span>
                      <span class="drop-hint">JPG · PNG · WebP · máx 5 MB</span>
                    </div>
                    <img id="image-preview" class="image-preview-thumb" style="<%= recipe.imageUrl ? '' : 'display:none;' %>" src="<%= recipe.imageUrl || '' %>" alt="Vista previa" />
                  </div>
                  <div class="image-url-row">
                    <span class="form-help">O pega una URL:</span>
                    <input type="text" name="imageUrl" id="image-url-input" value="<%= recipe.imageUrl || '' %>" placeholder="https://..." />
                  </div>
                </div>

                <fieldset class="recipe-visual-fieldset">
                  <legend>Personalización visual <span class="muted">(para cuando no hay imagen)</span></legend>

                  <div class="form-group">
                    <label class="form-label-text">Color de acento</label>
                    <input type="hidden" name="accentColor" id="accent-color-hidden" value="<%= recipe.accentColor || '' %>" />
                    <div class="color-palette" id="color-palette">
                      <% 
                        const colors = [
                          { hex: "#c0392b", name: "Rojo chile" },
                          { hex: "#27ae60", name: "Verde cilantro" },
                          { hex: "#f39c12", name: "Amarillo maíz" },
                          { hex: "#e67e22", name: "Naranja cempasúchil" },
                          { hex: "#8e44ad", name: "Morado jamaica" },
                          { hex: "#2980b9", name: "Azul añil" },
                          { hex: "#6d4c41", name: "Café chocolate" },
                          { hex: "#546e7a", name: "Gris pizarra" }
                        ];
                      %>
                      <% colors.forEach(function(c) { %>
                        <button type="button" class="color-swatch <%= recipe.accentColor === c.hex ? 'is-selected' : '' %>" data-color="<%= c.hex %>" style="--sw:<%= c.hex %>" title="<%= c.name %>"></button>
                      <% }); %>
                      <button type="button" class="color-swatch color-swatch-clear <%= !recipe.accentColor ? 'is-selected' : '' %>" data-color="" title="Sin color">✕</button>
                    </div>
                  </div>

                  <div class="form-group">
                    <label class="form-label-text">Emoji de portada</label>
                    <input type="hidden" name="fallbackEmoji" id="fallback-emoji-hidden" value="<%= recipe.fallbackEmoji || '' %>" />
                    <div class="emoji-palette" id="emoji-palette">
                      <% ["🍳","🌮","🥘","🍲","🌯","🫕","🥗","🍜","🫔","🌶️","🍅","🥑","🧆","🥩","🍱","🫙"].forEach(function(e){ %>
                        <button type="button" class="emoji-swatch <%= recipe.fallbackEmoji === e ? 'is-selected' : '' %>" data-emoji="<%= e %>"><%= e %></button>
                      <% }) %>
                    </div>
                  </div>

                  <div class="form-group">
                    <label class="form-label-text">Estilo de portada</label>
                    <div class="cover-style-row">
                      <label class="cover-style-opt"><input type="radio" name="coverStyle" value="image" <%= recipe.coverStyle === 'image' || !recipe.coverStyle ? 'checked' : '' %> /> 🖼️ Imagen</label>
                      <label class="cover-style-opt"><input type="radio" name="coverStyle" value="gradient" <%= recipe.coverStyle === 'gradient' ? 'checked' : '' %> /> 🎨 Gradiente</label>
                      <label class="cover-style-opt"><input type="radio" name="coverStyle" value="symbol" <%= recipe.coverStyle === 'symbol' ? 'checked' : '' %> /> 🏷️ Símbolo</label>
                      <label class="cover-style-opt"><input type="radio" name="coverStyle" value="plain" <%= recipe.coverStyle === 'plain' ? 'checked' : '' %> /> ⬜ Plano</label>
                    </div>
                  </div>
                </fieldset>

                <div class="form-grid cols-2">
                  <label>
                    Región
                    <select name="region">
                      <option value="">Sin región</option>
                      <% regions.forEach((region) => { %>
                        <option value="<%= region._id %>" <%= String(recipe.region) === String(region._id) ? "selected" : "" %>><%= region.name %></option>
                      <% }); %>
                    </select>
                  </label>
                  <label>
                    Dificultad
                    <select name="difficulty">
                      <option value="facil" <%= recipe.difficulty === "facil" ? "selected" : "" %>>Fácil</option>
                      <option value="media" <%= recipe.difficulty === "media" || !recipe.difficulty ? "selected" : "" %>>Media</option>
                      <option value="dificil" <%= recipe.difficulty === "dificil" ? "selected" : "" %>>Difícil</option>
                    </select>
                  </label>
                </div>

                <div class="form-grid cols-2">
                  <label>
                    Min. preparación
                    <input type="number" name="prepMinutes" min="0" value="<%= recipe.prepMinutes || 0 %>" />
                  </label>
                  <label>
                    Min. cocción
                    <input type="number" name="cookMinutes" min="0" value="<%= recipe.cookMinutes || 0 %>" />
                  </label>
                </div>

                <div class="form-grid cols-2">
                  <label>
                    Porciones
                    <input type="number" name="servings" min="1" value="<%= recipe.servings || 1 %>" />
                  </label>
                  <label>
                    Estado
                    <select name="status">
                      <option value="borrador" <%= recipe.status === "borrador" ? "selected" : "" %>>Borrador</option>
                      <option value="publicada" <%= recipe.status === "publicada" || !recipe.status ? "selected" : "" %>>Publicada</option>
                      <option value="archivada" <%= recipe.status === "archivada" ? "selected" : "" %>>Archivada</option>
                    </select>
                  </label>
                </div>

                <label>
                  Etiquetas (separadas por coma)
                  <input type="text" name="tags" value="<%= (recipe.tags || []).join(', ') %>" placeholder="mexicana, fuego lento, tradicional" />
                </label>

                <div class="ing-picker">
                  <span class="form-label">Ingredientes</span>
                  <div class="ing-cat-pills" id="ing-cat-pills"></div>
                  <div class="actions" style="margin-bottom:.5rem;gap:.5rem;">
                    <input type="text" id="ing-search" class="ing-search" placeholder="Buscar ingrediente..." autocomplete="off" />
                    <input type="text" id="ing-quick-name" class="ing-search" placeholder="Ingrediente rápido..." autocomplete="off" />
                    <select id="ing-quick-category" aria-label="Categoría rápida">
                      <option value="otro" selected>Cat: otro</option>
                      <option value="verdura">Cat: verdura</option>
                      <option value="fruta">Cat: fruta</option>
                      <option value="proteina">Cat: proteina</option>
                      <option value="grano">Cat: grano</option>
                      <option value="especia">Cat: especia</option>
                      <option value="lacteo">Cat: lacteo</option>
                      <option value="aceite">Cat: aceite</option>
                      <option value="condimento">Cat: condimento</option>
                      <option value="chile">Cat: chile</option>
                      <option value="salsa">Cat: salsa</option>
                      <option value="bebida">Cat: bebida</option>
                      <option value="conserva">Cat: conserva</option>
                      <option value="hongo">Cat: hongo</option>
                    </select>
                    <select id="ing-quick-unit" aria-label="Unidad rápida">
                      <option value="g" selected>Uni: g</option>
                      <option value="kg">Uni: kg</option>
                      <option value="ml">Uni: ml</option>
                      <option value="l">Uni: l</option>
                      <option value="pieza">Uni: pieza</option>
                      <option value="cdita">Uni: cdita</option>
                      <option value="cda">Uni: cda</option>
                      <option value="taza">Uni: taza</option>
                      <option value="manojo">Uni: manojo</option>
                      <option value="ramita">Uni: ramita</option>
                      <option value="lata">Uni: lata</option>
                      <option value="botella">Uni: botella</option>
                      <option value="sobre">Uni: sobre</option>
                      <option value="diente">Uni: diente</option>
                    </select>
                    <button type="button" id="ing-quick-add" class="btn btn-soft btn-sm">+ Crear rápido</button>
                  </div>
                  <div class="ing-catalog" id="ing-catalog"></div>
                  <div class="ing-selected" id="ing-selected"></div>
                  
                  <textarea name="ingredientsData" id="ing-data" style="display:none"><%= (recipe.ingredients || []).map((item) => `${item.ingredientName || ''}|${item.quantity || 0}|${item.unit || ''}|${item.notes || ''}|${item.ingredient || ''}`).join('\n') %></textarea>
                </div>

                <div class="step-builder">
                  <span class="form-label">Pasos de preparación</span>
                  <ol class="steps-list-builder" id="steps-list"></ol>
                  <div class="step-nodes-wrap" id="step-nodes-wrap"></div>
                  <button type="button" class="btn btn-soft btn-sm add-step-btn" id="add-step-btn">
                    &#65291;&nbsp;Agregar paso
                  </button>
                  
                  <textarea name="stepsData" id="steps-data" style="display:none"><%= (recipe.steps || []).map((step) => step.text).join('\n') %></textarea>
                </div>

                <div class="actions">
                  <button class="btn btn-primary" type="submit">Actualizar receta</button>
                  <a class="btn btn-soft" href="/recipes/<%= recipe._id %>">Cancelar</a>
                </div>
              </form>
            </article>

            <aside class="card reveal">
              <h3>Vista previa</h3>
              <div id="recipe-preview" class="muted"></div>
              <div id="step-nodes-preview-wrap" style="display:none;margin-top:1rem;">
                <h4 style="margin-bottom:.5rem;font-size:.9rem;">Flujo de pasos</h4>
                <div id="step-nodes-preview"></div>
              </div>
              <p class="form-help" style="margin-top:.75rem;">La previsualización se actualiza en tiempo real mientras escribes.</p>
            </aside>
          </section>
        <% } %>

        <%- include("../partials/footer") %>
      </main>
    </div>

    <script id="ingredients-data" type="application/json"><%- JSON.stringify(typeof allIngredients !== 'undefined' ? allIngredients : []) %></script>
    <script src="/js/forms.js"></script>
    <script>
      // Color palette picker
      (function() {
        var palette = document.getElementById('color-palette');
        var hidden  = document.getElementById('accent-color-hidden');
        if (!palette || !hidden) return;
        palette.querySelectorAll('.color-swatch').forEach(function(btn) {
          btn.addEventListener('click', function() {
            palette.querySelectorAll('.color-swatch').forEach(function(b){ b.classList.remove('is-selected'); });
            btn.classList.add('is-selected');
            hidden.value = btn.dataset.color || '';
          });
        });
      })();
      
      // Emoji palette picker
      (function() {
        var palette = document.getElementById('emoji-palette');
        var hidden  = document.getElementById('fallback-emoji-hidden');
        if (!palette || !hidden) return;
        palette.querySelectorAll('.emoji-swatch').forEach(function(btn) {
          btn.addEventListener('click', function() {
            palette.querySelectorAll('.emoji-swatch').forEach(function(b){ b.classList.remove('is-selected'); });
            if (hidden.value === btn.dataset.emoji) {
              hidden.value = '';
            } else {
              btn.classList.add('is-selected');
              hidden.value = btn.dataset.emoji;
            }
          });
        });
      })();
    </script>
  </body>
</html>