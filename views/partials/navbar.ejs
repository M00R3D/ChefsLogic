<nav class="topnav">
  <a class="brand" href="/">Chef's Logic</a>

  <div class="nav-links">
    <a class="nav-link <%= activeTab === 'inicio' ? 'is-active' : '' %>" href="/">Explorar</a>
    <a class="nav-link <%= activeTab === 'recetas' ? 'is-active' : '' %>" href="/recipes">Recetario</a>
    <a class="nav-link <%= activeTab === 'ingredientes' ? 'is-active' : '' %>" href="/ingredients">Ingredientes</a>
    <a class="nav-link <%= activeTab === 'recetarios' ? 'is-active' : '' %>" href="/cookbooks">Recetarios</a>
  </div>

  <div class="nav-actions">
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <div class="nav-user">
        <div class="nav-avatar"><%= currentUser.name.charAt(0).toUpperCase() %></div>
        <span><%= currentUser.name.split(' ')[0] %></span>
      </div>
      <form action="/logout" method="POST" style="margin:0">
        <button class="btn btn-ghost btn-sm" type="submit">Salir</button>
      </form>
    <% } else { %>
      <a class="btn btn-ghost btn-sm" href="/login">Ingresar</a>
      <a class="btn btn-primary btn-sm" href="/register">Registrarse</a>
    <% } %>
  </div>
</nav>
